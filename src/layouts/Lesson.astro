---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import LessonHead from '@/components/lesson/LessonHead.astro';
import OnThisPage from '@/components/lesson/OnThisPage.astro';
import ContinueInModule from '@/components/lesson/ContinueInModule.astro';
import PrevNext from '@/components/lesson/PrevNext.astro';
import StageTracker from '@/components/lesson/StageTracker.astro';
import { MODULES } from '@/data/curriculum/modules';
import { SUBTOPICS } from '@/data/curriculum/subtopics';
import { curriculumOrder, lessonNav } from '@/lib/lessonNav';
import { inlineMarkdownText } from '@/lib/inlineMarkdown';
import { metaDescription } from '@/lib/metaDescription';
import 'katex/dist/katex.min.css';
import '@/styles/prose.css';
import '@/styles/lesson-layout.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NeighborLink {
  slug: string;
  title: string;
}

interface Props {
  slug: string;
  frontmatter: {
    module: string;
    cycle: 'I' | 'II' | 'III';
    title: string;
    objective: string;
    description?: string;
    framework: 'hands-on' | 'conceptual' | 'hybrid' | 'project';
    duration: string;
    published?: Date;
    level: string;
    load?: string;
    prereqs?: string;
    prev: NeighborLink | null;
    next: NeighborLink | null;
    backLink?: { href: string; label: string };
    faq?: { q: string; a: string }[];
  };
  headings: Heading[];
  /** URL of this lesson's /lesson-media/ folder; used by the in-browser Python runner. */
  mediaBase?: string;
}

const { slug, frontmatter, headings, mediaBase } = Astro.props;

// In-browser Python runner (AI tutor Milestone 1b), behind a flag:
// always on in `npm run dev`; in production only when PUBLIC_PYTHON_RUNNER=true is set
// in Netlify, or for one visitor who opens a lesson with ?runner=1 (for live testing).
// Scope: Modules 1-3, whose scripts are verified to run in Pyodide.
const RUNNER_MODULES = new Set(['1', '2', '3']);
const runnerInScope = RUNNER_MODULES.has(slug.split('.')[0]) && Boolean(mediaBase);
const runnerDefault = import.meta.env.DEV || import.meta.env.PUBLIC_PYTHON_RUNNER === 'true';
const f = frontmatter;
// Plain-text objective (no `code` / *em* markers) for meta, og and JSON-LD.
const plainObjective = inlineMarkdownText(f.objective);
// Search snippet: frontmatter description, else the objective trimmed to ~160.
const snippet = metaDescription(plainObjective, f.description);

// Previous/Next come from curriculum order, skipping leaves that aren't
// shipped yet, so they never dead-end and track new lessons automatically.
// Frontmatter prev/next is only a fallback for an MDX not yet wired into
// subtopics.ts. See src/lib/lessonNav.ts.
const lessonTitles = new Map(
  (await getCollection('lessons')).map((l) => [l.id, l.data.title] as const)
);
const { prev, next } = lessonNav(
  slug,
  curriculumOrder(MODULES, SUBTOPICS),
  lessonTitles,
  { prev: f.prev, next: f.next }
);

// schema.org timeRequired is an ISO 8601 duration. Frontmatter holds a range
// ("20–25 min"), which ISO can't express, so use the rounded midpoint as the
// typical time (PT23M). Anything unparseable is simply omitted.
function isoDuration(d: string): string | null {
  const m = d.match(/(\d+)\s*[–-]\s*(\d+)\s*min/) ?? d.match(/(\d+)\s*min/);
  if (!m) return null;
  const minutes = m[2] ? Math.round((Number(m[1]) + Number(m[2])) / 2) : Number(m[1]);
  return `PT${minutes}M`;
}

const lessonJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: f.title,
  description: plainObjective,
  educationalLevel: f.level,
  learningResourceType: 'lesson',
  ...(isoDuration(f.duration) ? { timeRequired: isoDuration(f.duration) } : {}),
  // Same @id as the homepage Course entity, so the lesson joins that graph.
  isPartOf: { '@type': 'Course', '@id': new URL('/#course', Astro.site).href, name: 'Pixels2GenAI' },
  inLanguage: 'en',
  ...(f.published ? { datePublished: f.published.toISOString().slice(0, 10) } : {}),
  url: new URL(`/lessons/${slug}`, Astro.site).href,
};

// Breadcrumb trail (Curriculum → Module → Subtopic → Lesson), derived from the
// slug's numeric segments so it stays correct as modules are ported. The module
// and subtopic levels have no dedicated page yet, so they point at the
// curriculum section on the landing page.
const [moduleNum, subNum] = slug.split('.'); // "2.1.1" → ["2","1"]
const moduleIdx = moduleNum.padStart(2, '0'); // "02"
const subtopicId = `${moduleNum}.${subNum}`; // "2.1"
const moduleEntry = MODULES.find((m) => m.idx === moduleIdx);
const subtopicEntry = SUBTOPICS[moduleIdx]?.find((s) => s.id === subtopicId);
const moduleName = moduleEntry
  ? (moduleEntry.name ?? `${moduleEntry.title} ${moduleEntry.em}`.trim())
  : `Module ${moduleNum}`;
const curriculumUrl = new URL('/#curriculum', Astro.site).href;

const breadcrumbItems = [
  { name: 'Curriculum', item: curriculumUrl },
  { name: moduleName, item: curriculumUrl },
  ...(subtopicEntry ? [{ name: subtopicEntry.title, item: curriculumUrl }] : []),
  { name: f.title, item: new URL(`/lessons/${slug}`, Astro.site).href },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((entry, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: entry.name,
    item: entry.item,
  })),
};

// FAQPage JSON-LD — only when the lesson author has supplied `faq` pairs that
// mirror visible on-page Q&A. Omitted entirely otherwise.
const faqJsonLd =
  f.faq && f.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: f.faq.map((pair) => ({
          '@type': 'Question',
          name: pair.q,
          acceptedAnswer: { '@type': 'Answer', text: pair.a },
        })),
      }
    : null;

const jsonLdBlocks = [lessonJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<Base
  title={`${slug} ${f.title}`}
  description={snippet}
  ogImage={`/og/lessons/${slug}.png`}
  jsonLd={jsonLdBlocks}
>
  <StageTracker currentModule={f.module} cycle={f.cycle} />

  <main id="main-content" class="page" data-cycle={f.cycle}>
    <article
      class="col-main lesson"
      data-runner={runnerInScope ? (runnerDefault ? 'on' : 'flag') : undefined}
      data-lesson-media={runnerInScope ? mediaBase : undefined}
    >
      <LessonHead
        slug={slug}
        module={f.module}
        title={f.title}
        objective={f.objective}
        framework={f.framework}
        duration={f.duration}
        level={f.level}
        load={f.load}
        prereqs={f.prereqs}
      />
      <slot />
      <PrevNext slug={slug} prev={prev} next={next} backLink={f.backLink} />
    </article>

    <aside class="col-right">
      <OnThisPage headings={headings} slug={slug} cycle={f.cycle} />
      <ContinueInModule slug={slug} currentModule={f.module} />
    </aside>
  </main>
</Base>
