---
/**
 * The last /try screen (16 Nov 2026, Kağan's test run: "below section should be the final page, not scroll down from
 * the summary"). It holds only the done box: lesson.ts fills <div data-wrap-status> with "✓ Sample done." and the
 * workshops link, or with the checks still open. Phase "wrap", so the progress line groups it with Wrap up and
 * lesson.ts fills the box. No minutes: the 15 minutes end on Wrap up. Next is hidden here (the last screen).
 *   <TryDone />    after </TryWrap>
 */
import Screen from '@/components/workshop-lesson/Screen.astro';

interface Props {
  title?: string;
}

const { title = 'What comes next' } = Astro.props;
---

<Screen phase="wrap" kind="wrap" kicker="Finish" title={title}>
  <div class="wb-wrap-status" data-wrap-status aria-live="polite"></div>
</Screen>
