---
interface Props {
  eyebrow: string;
  headline: string;
  headlineEm?: string;
  lede: string;
  sample: string;
  method: string;
  instruments: string;
  analysis: string;
}

const { eyebrow, headline, headlineEm, lede, sample, method, instruments, analysis } = Astro.props;

// M-20: on phones, a 3 x 3 grid of jumps to the nine sections of /research
// (the anchors in research.mdx). Wider screens have the side table of contents.
const JUMPS = [
  ['overview', 'I Overview'], ['method', 'II Method'], ['rq1', 'III Design'],
  ['rq2', 'IV Load'], ['rq3', 'V Real-time'], ['rq4', 'VI Gains'],
  ['rq5', 'VII Transfer'], ['themes', 'VIII Themes'], ['limits', 'IX Limits'],
];
---

<header class="research-head">
  <div class="research-eyebrow">
    <span class="dot" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </div>

  <h1>
    {headline}
    {headlineEm && <> <em>{headlineEm}</em></>}
  </h1>

  <p class="research-lede">{lede}</p>

  <div class="research-meta">
    <div><b>Method</b><span>{method}</span></div>
    <div><b>Sample</b><span>{sample}</span></div>
    <div><b>Instruments</b><span>{instruments}</span></div>
    <div><b>Analysis</b><span>{analysis}</span></div>
  </div>

  <nav class="jump-grid" aria-label="Sections of the study">
    {JUMPS.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>
</header>
