---
/**
 * RS-11 (19 Nov): page head for /research: eyebrow, title, a short lede, two
 * thesis buttons and four facts. All text comes from research.mdx frontmatter.
 */
interface Props {
  eyebrow: string;
  headline: string;
  headlineEm?: string;
  lede: string;
  meta: { label: string; value: string }[];
}

const { eyebrow, headline, headlineEm, lede, meta } = Astro.props;
---

<header class="research-head">
  <div class="research-eyebrow">
    <span class="dot" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </div>

  <h1>
    {headline}
    {headlineEm && <> <em>{headlineEm}</em></>}
  </h1>

  <p class="research-lede">{lede}</p>

  <div class="rs-ctas">
    <a class="btn btn-pri" href="/research/thesis.pdf">Read the thesis (PDF) →</a>
    <a class="btn btn-sec" href="/research/evaluation-summary.pdf">Evaluation summary (PDF)</a>
  </div>

  <div class="research-meta">
    {meta.map((m) => <div><b>{m.label}</b><span>{m.value}</span></div>)}
  </div>
</header>
