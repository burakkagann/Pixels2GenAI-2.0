---
/**
 * One exhibition rendered as a collapsible <details> row in the landing § 3
 * archive. It uses the § 2 archive anatomy (workshops.css: .workshop-specimen,
 * .specimen-summary, .specimen-dl, .specimen-actions) and fills the body with
 * a framed wall of exhibited works beside the wall text (DEC E2, C1, R1).
 *
 * The wall reads from `exhibition.landingWall` (ordered work ids). A print
 * stands for its series: the tag shows the series title and the medium line
 * the number of prints in it. Animated works without a still are skipped;
 * the facts still count them.
 */
import type { Exhibition } from '@/data/site/exhibitions';

interface Props {
  exhibition: Exhibition;
  defaultOpen?: boolean;
}

const { exhibition: ex, defaultOpen = false } = Astro.props;

// Roman lowercase ordinal → zero-padded Arabic ("i" → "01").
const romanToArabic: Record<string, number> = {
  i: 1, ii: 2, iii: 3, iv: 4, v: 5, vi: 6, vii: 7, viii: 8, ix: 9, x: 10,
};
const indexDisplay = String(romanToArabic[ex.ordinal.toLowerCase()] ?? 0).padStart(2, '0');

const numberWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const artistCount = numberWords[ex.artists.length] ?? String(ex.artists.length);

// `exhibition-2026-03` → `/exhibitions/2026-03`.
const route = `/exhibitions/${ex.id.replace(/^exhibition-/, '')}`;

const opened = new Date(`${ex.dateIso}T00:00:00Z`);
const monthYear = opened.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

type Frame = { href: string; src: string; alt: string; tag: string; medium: string };

const frames: Frame[] = (ex.landingWall ?? [])
  .map((id): Frame | null => {
    const print = ex.printedWorks.find((w) => w.id === id);
    if (print) {
      const series = ex.printSeries?.find((s) => s.workIds.includes(id));
      const count = series?.workIds.length ?? 1;
      const label = print.subtitle ? `${print.title} · ${print.subtitle}` : print.title;
      return {
        href: `${route}#prints`,
        src: print.src,
        alt: `${label}, printed work by ${print.artist}.`,
        tag: series?.title ?? print.title,
        medium: count === 1 ? '1 print' : `${count} prints`,
      };
    }
    const live = ex.animatedWorks.find((w) => w.id === id);
    if (live?.stillSrc) {
      return {
        href: `${route}#animated`,
        src: live.stillSrc,
        alt: `${live.title}, still frame of the live piece by ${live.artist}.`,
        tag: live.title,
        medium: 'Live · screen',
      };
    }
    return null; // unknown id, or a live piece with no capture yet
  })
  .filter((f): f is Frame => f !== null);

const strip = (s: string, word: string) => s.replace(new RegExp(`\\s*—\\s*${word}$`), '').replace(' · ', ', ');
---

<details class="workshop-specimen exhibition-row" open={defaultOpen}>
  <summary class="specimen-summary">
    <span class="summary-index">{indexDisplay}</span>
    <span class="summary-status completed done">✓ Completed</span>
    <span class="summary-identifier">Group show · <em>{artistCount} artists</em></span>
    <span class="summary-meta">{ex.city} · {ex.dateRange ?? ex.date}</span>
    <span class="summary-chevron" aria-hidden="true">
      <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="2,2 6,6 10,2"></polyline>
      </svg>
    </span>
  </summary>

  <article class="specimen-body exhibition-wall-body">
    <ul class="exhibition-wall" aria-label="Works in the show">
      {frames.map((f) => (
        <li>
          <a class="exhibition-frame" href={f.href} aria-label={`${f.tag}, ${f.medium.toLowerCase()}: on the exhibition page`}>
            <span class="exhibition-frame-tag">{f.tag}</span>
            <img src={f.src} alt={f.alt} width="480" height="360" loading="lazy" decoding="async" />
            <span class="exhibition-frame-medium">{f.medium}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="exhibition-wall-label">
      <p class="exhibition-wall-eyebrow">{indexDisplay} · {monthYear} · {ex.city}</p>
      <h3 class="exhibition-wall-title">The first group show</h3>
      <p class="exhibition-wall-lede">
        For two days the Academis office became a gallery: prints on the walls,
        code-driven pieces on screens. Several grew from curriculum modules.
      </p>
      <dl class="specimen-dl">
        <dt>Dates</dt>
        <dd>{strip(ex.openingHours, 'opening')} · <em>opening</em> · {strip(ex.publicHours, 'public')} · <em>public</em></dd>

        <dt>Where</dt>
        <dd>{ex.venue} · {ex.address}{ex.station && <> · <em>{ex.station}</em></>} · {ex.city}</dd>

        <dt>Artists</dt>
        <dd>{ex.artists.map((a) => a.name).join(', ')}</dd>

        <dt>Works</dt>
        <dd>{ex.printedWorks.length} prints · {ex.animatedWorks.length} live pieces · admission {ex.admission.toLowerCase()}</dd>
      </dl>
    </div>
  </article>

  <div class="specimen-actions exhibition-row-actions">
    <a class="btn btn-pri" href={route}>See the exhibition →</a>
    <a class="btn-ghost" href="/announce?topic=exhibitions" data-announce data-topic="exhibitions">Hear about the next show →</a>
  </div>
</details>
