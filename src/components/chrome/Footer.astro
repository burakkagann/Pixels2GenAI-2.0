---
// Site footer. Rendered on the landing page and the standalone pages
// (research, workshops, exhibition, announce, imprint, privacy, 404).
// Styles live in src/styles/landing.css under `.foot*`
// (colophon star CTA under `.colo*`).
import { getStarCount, formatStars, GITHUB_REPO } from '@/lib/github';
import { SPARKLE_PIXELS } from '@/lib/pixelGlyphs';

// Build-time star count — memoised module-wide, so this shares FrameTop's
// single fetch rather than adding one.
const stars = await getStarCount();

// The "Manual" links target sections on the landing page. On any other page an
// in-page "#curriculum" anchor is dead, so prefix with "/" off-landing (mirrors
// FrameTop's onLanding handling).
const prefix = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="foot" id="colophon">
  <div class="colo">
    <svg class="colo-glyph" viewBox="0 0 7 7" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true">
      {SPARKLE_PIXELS.map((p) => (
        <rect x={p.x} y={p.y} width="1" height="1" />
      ))}
    </svg>
    <p class="colo-line">
      If this curriculum has been useful to you, consider leaving a star in the repo.<br />
      It helps other learners find it.
    </p>
    <a
      class="colo-link"
      href={`https://github.com/${GITHUB_REPO}`}
      target="_blank"
      rel="noopener"
      aria-label={stars !== null
        ? `Star Pixels2GenAI on GitHub — currently ${stars} ${stars === 1 ? 'star' : 'stars'}`
        : 'Star Pixels2GenAI on GitHub'}
    >
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor">
        <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
      </svg>
      Star on GitHub
      {/* Build-time fallback; refreshed client-side by the FrameTop script.
          Rendered even when null so the script has a target. */}
      <span class="colo-count">{stars !== null ? `· ${formatStars(stars)}` : ''}</span>
    </a>
  </div>
  <div class="foot-grid">
    <div>
      <h4>Pixels2GenAI</h4>
      <p class="about-blurb">
        A free, open-source curriculum for generative art and AI — written as a Master's thesis in creative computing.
      </p>
      <dl class="about-meta">
        <dt>Author</dt>
        <dd><a href="https://burakkagan.dev" target="_blank" rel="noopener">Burak Kağan Yılmazer <span class="arr">↗</span></a></dd>
        <dt>Supervisor</dt>
        <dd><a href="https://www.academis.eu" target="_blank" rel="noopener">Kristian Rother <span class="arr">↗</span></a></dd>
        <dt>Released</dt>
        <dd>2026</dd>
      </dl>
    </div>
    <div>
      <h4>Manual</h4>
      <ul>
        <li><a href={`${prefix}#curriculum`}>§ 1 Curriculum</a></li>
        <li><a href={`${prefix}#workshops`}>§ 2 Workshops</a></li>
        <li><a href={`${prefix}#exhibition`}>§ 3 Exhibition</a></li>
        <li><a href={`${prefix}#research`}>§ 4 Research</a></li>
        <li><a href={`${prefix}#announcements`}>§ Announcements</a></li>
      </ul>
    </div>
    <div>
      <h4>Code</h4>
      <ul>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0" target="_blank" rel="noopener">GitHub repo</a></li>
        <li><a href="https://burakkagann.github.io/Pixels2GenAI/" target="_blank" rel="noopener">Legacy edition (v1)</a></li>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0/releases" target="_blank" rel="noopener">Releases</a></li>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0/issues" target="_blank" rel="noopener">Issues</a></li>
      </ul>
    </div>
    <div>
      <h4>Research</h4>
      <ul>
        <li><a href="/research">Research overview</a></li>
        <li><a href="/research#rq4">Findings</a></li>
        <li><a href="/research#method">Method &amp; instruments</a></li>
        <li><a href="/research#themes">Themes</a></li>
        <li><a href="/research#limits">Limitations</a></li>
        <li><a href="/research/thesis.pdf" download>Download thesis · PDF</a></li>
        <li><a href="mailto:burak.kagan@protonmail.com">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="bottom">
    <span>© Copyright 2026, Burak Kağan Yılmazer & Kristian Rother · MIT (code) · CC-BY 4.0 (text) · <a href="/imprint">Imprint</a> · <a href="/privacy">Privacy</a></span>
    <span>v2 · Pressmark P2GA-r · 2026</span>
  </div>
</footer>
