---
// Site footer. Rendered on the landing page and the standalone pages
// (research, workshops, exhibition, announce, imprint, privacy, 404).
// Styles live in src/styles/landing.css under `.foot*`
// (open-source strip with the star button under `.gs*`).
import { getStarCount, formatStars, shippedLessonCount, GITHUB_REPO } from '@/lib/github';
import { STAR_PIXELS } from '@/lib/pixelGlyphs';

// Build-time star count — memoised module-wide, so this shares FrameTop's
// single fetch rather than adding one.
const stars = await getStarCount();
const lessonCount = shippedLessonCount();

// The "Manual" links target sections on the landing page. On any other page an
// in-page "#curriculum" anchor is dead, so prefix with "/" off-landing (mirrors
// FrameTop's onLanding handling).
const prefix = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="foot" id="colophon">
  <section class="gs" aria-label="Open source">
    <div class="gs-strip"><b>Pixels2GenAI · Open source</b><span>▌ MIT code · CC BY 4.0 text</span></div>
    <div class="gs-row">
      <p class="gs-line">{lessonCount} free lessons, open source on GitHub. A star helps other learners find them.</p>
      <a
        class="btn btn-pri gs-btn colo-link"
        href={`https://github.com/${GITHUB_REPO}`}
        target="_blank"
        rel="noopener"
        aria-label={stars !== null
          ? `Star Pixels2GenAI on GitHub — currently ${stars} ${stars === 1 ? 'star' : 'stars'}`
          : 'Star Pixels2GenAI on GitHub'}
      >
        <span class="gs-face">
          {/* The same 11 x 11 pixel star as the header chip: a base layer in
              the button ink and a yellow layer that wipes in once (below). */}
          <span class="gs-px" aria-hidden="true">
            <svg class="px-base" viewBox="0 0 11 11" width="16" height="16" shape-rendering="crispEdges">
              {STAR_PIXELS.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}
            </svg>
            <span class="px-lit-wrap">
              <svg class="px-lit" viewBox="0 0 11 11" width="16" height="16" shape-rendering="crispEdges">
                {STAR_PIXELS.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}
              </svg>
            </span>
          </span>
          Star on GitHub
        </span>
        {/* Count segment: build-time fallback, refreshed client-side by the
            FrameTop script. Hidden while :empty, so a failed load leaves the
            plain button. */}
        <span class="gs-n colo-count">{stars !== null ? formatStars(stars) : ''}</span>
      </a>
    </div>
  </section>
  <div class="foot-grid">
    <div>
      <h4>Pixels2GenAI</h4>
      <p class="about-blurb">
        A free, open-source curriculum for generative art and AI — written as a Master's thesis in creative computing.
      </p>
      <dl class="about-meta">
        <dt>Author</dt>
        <dd><a href="https://burakkagan.dev" target="_blank" rel="noopener">Burak Kağan Yılmazer <span class="arr">↗</span></a></dd>
        <dt>Supervisor</dt>
        <dd><a href="https://www.academis.eu" target="_blank" rel="noopener">Kristian Rother <span class="arr">↗</span></a></dd>
        <dt>Released</dt>
        <dd>2026</dd>
      </dl>
    </div>
    <div>
      <h4>Manual</h4>
      <ul>
        <li><a href={`${prefix}#curriculum`}>§ 1 Curriculum</a></li>
        <li><a href={`${prefix}#workshops`}>§ 2 Workshops</a></li>
        <li><a href={`${prefix}#exhibition`}>§ 3 Exhibition</a></li>
        <li><a href={`${prefix}#research`}>§ 4 Research</a></li>
        {/* Opens the sign-up pop-up in place (AnnounceModal, via Base.astro);
            /announce is only the no-JS fallback. */}
        <li><a href="/announce" data-announce data-topic="both">§ Announcements</a></li>
      </ul>
    </div>
    <div>
      <h4>Code</h4>
      <ul>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0" target="_blank" rel="noopener">GitHub repo</a></li>
        <li><a href="https://burakkagann.github.io/Pixels2GenAI/" target="_blank" rel="noopener">Legacy edition (v1)</a></li>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0/releases" target="_blank" rel="noopener">Releases</a></li>
        <li><a href="https://github.com/burakkagann/Pixels2GenAI-2.0/issues" target="_blank" rel="noopener">Issues</a></li>
      </ul>
    </div>
    <div>
      <h4>Research</h4>
      <ul>
        <li><a href="/research">Research overview</a></li>
        <li><a href="/research#rq4">Findings</a></li>
        <li><a href="/research#method">Method &amp; instruments</a></li>
        <li><a href="/research#themes">Themes</a></li>
        <li><a href="/research#limits">Limitations</a></li>
        <li><a href="/research/thesis.pdf" download>Download thesis · PDF</a></li>
        <li><a href="mailto:kagan@pixels2genai.art">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="bottom">
    <span>© Copyright 2026, Burak Kağan Yılmazer & Kristian Rother · MIT (code) · CC-BY 4.0 (text) · <a href="/imprint">Imprint</a> · <a href="/privacy">Privacy</a></span>
    <span>v2 · Pressmark P2GA-r · 2026</span>
  </div>
</footer>

<script>
  // The pixel star assembles once per page view, when the strip is at least
  // 60 % on screen; it pauses while off screen and stays static under
  // prefers-reduced-motion (the CSS also disables it).
  const strip = document.querySelector<HTMLElement>('.foot .gs');
  if (strip && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    let played = false;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio >= 0.6) {
          strip.classList.remove('gs-paused');
          if (!played) {
            played = true;
            strip.classList.add('gs-lit');
            window.setTimeout(() => strip.classList.remove('gs-lit'), 1400);
          }
        } else {
          strip.classList.add('gs-paused');
        }
      },
      { threshold: [0, 0.6] },
    );
    io.observe(strip);
  }
</script>
