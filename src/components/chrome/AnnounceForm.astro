---
/**
 * The shared announcements form (Netlify Forms, name="announcements"),
 * design A1a "Slip": topic row, email and button on one row, name and
 * note folded. Rendered in two places:
 *
 *   - inside AnnounceModal.astro (the pop-up on every page; it submits
 *     with fetch as a Netlify AJAX post and shows its own thanks state)
 *   - on /announce (the no-JS fallback page; submits natively and the
 *     POST lands on /announce/thanks)
 *
 * Netlify detects the form from the static HTML at deploy time:
 * data-netlify, the hidden form-name input, the honeypot and the field
 * names email / name / topics (workshops | exhibitions | both) /
 * interests are load-bearing, and /privacy describes exactly these
 * fields. The topic defaults to "Both" so the form is valid without JS.
 *
 * With JS, the script below replaces the browser's validation bubble
 * with an inline message under the email field (in English, whatever
 * the browser's language). Without JS the browser's own check stands.
 * Styles: src/styles/announce.css (.signup-form).
 */
import { ANNOUNCE_TOPICS, type AnnounceTopic } from '@/data/site/announce';

interface Props {
  /** Prefix for the element ids, unique per form on a page. */
  idPrefix: string;
  /** The topic checked in the static HTML. */
  topic?: AnnounceTopic;
  /** In the pop-up, the privacy link opens a new tab so the visitor keeps
   *  the page and what they typed. */
  inModal?: boolean;
}

const { idPrefix, topic = 'both', inModal = false } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;
const TOPIC_LABEL: Record<AnnounceTopic, string> = {
  workshops: 'Workshops',
  exhibitions: 'Exhibitions',
  both: 'Both',
};
---

<form
  name="announcements"
  method="POST"
  action="/announce/thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="signup-form"
>
  <input type="hidden" name="form-name" value="announcements" />
  {/* Spam trap: off-screen, and also out of the Tab order and hidden from
      screen readers so keyboard / AT users never land in it. */}
  <p class="honeypot" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <fieldset class="sf-topics">
    <legend>Tell me about</legend>
    <div class="sf-chip-row">
      {ANNOUNCE_TOPICS.map((value) => (
        <label>
          <input type="radio" name="topics" value={value} checked={value === topic} />
          <span>{TOPIC_LABEL[value]}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="sf-field">
    <label for={id('email')}>Email</label>
    <div class="sf-email-row">
      <input
        id={id('email')}
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        spellcheck="false"
        aria-describedby={id('email-err')}
      />
      <button type="submit" class="btn btn-pri btn-signup">Add me to the list →</button>
    </div>
    <p class="sf-err" id={id('email-err')} hidden></p>
  </div>

  <details class="sf-more">
    <summary>Add a name or a wish <span class="sf-opt">optional</span></summary>
    <div class="sf-more-body">
      <div class="sf-field">
        <label for={id('name')}>Name <span class="sf-opt">optional</span></label>
        <input id={id('name')} type="text" name="name" autocomplete="name" />
      </div>
      <div class="sf-field">
        <label for={id('note')}>What should the next one cover? <span class="sf-opt">optional</span></label>
        <textarea id={id('note')} name="interests" rows="2" placeholder="One or two sentences."></textarea>
      </div>
    </div>
  </details>

  <p class="am-error" role="alert" hidden>Sending failed. Check your connection and try again.</p>

  <p class="sf-consent">
    We keep what you enter only to send these announcements: sent by hand,
    BCC, never shared. Reply to any of them to leave the list.
    {inModal
      ? <a href="/privacy" target="_blank" rel="noopener">Privacy note<span class="sr-only"> (opens in a new tab)</span></a>
      : <a href="/privacy">Privacy note</a>}
  </p>
</form>

<script>
  // Inline email check (F4). Runs for every announcements form on the page.
  // The listener is on the document in the capture phase, so it runs before
  // the pop-up's own submit handler and can stop an invalid send.
  const MSG_EMPTY = 'Enter your email address.';
  const MSG_INVALID = 'Check the address: it needs an @ and a domain, like name@example.com.';

  const forms = document.querySelectorAll<HTMLFormElement>('form.signup-form');

  function parts(form: HTMLFormElement) {
    const email = form.querySelector<HTMLInputElement>('input[name="email"]');
    const err = email ? document.getElementById(email.getAttribute('aria-describedby') ?? '') : null;
    return { email, err };
  }

  function setError(form: HTMLFormElement, message: string | null) {
    const { email, err } = parts(form);
    if (!email || !err) return;
    err.textContent = message ?? '';
    err.hidden = !message;
    if (message) email.setAttribute('aria-invalid', 'true');
    else email.removeAttribute('aria-invalid');
  }

  forms.forEach((form) => {
    // Our own message replaces the browser bubble; without JS it stays.
    form.noValidate = true;
    const { email } = parts(form);
    // Clear the message as soon as the address becomes valid.
    email?.addEventListener('input', () => {
      if (email.getAttribute('aria-invalid') && email.checkValidity()) setError(form, null);
    });
  });

  document.addEventListener(
    'submit',
    (e) => {
      const form = e.target as HTMLFormElement;
      if (!form.matches?.('form.signup-form')) return;
      const { email } = parts(form);
      if (!email) return;
      email.value = email.value.trim();
      if (email.checkValidity()) {
        setError(form, null);
        return;
      }
      e.preventDefault();
      e.stopImmediatePropagation();
      setError(form, email.validity.valueMissing ? MSG_EMPTY : MSG_INVALID);
      email.focus();
    },
    true,
  );
</script>
