---
/**
 * Wraps a fenced code block in the Nocturne `.code` chrome.
 * MDX usage:
 *   <CodeBlock lang="python" file="fractal_square.py">
 *   ```python
 *   def fractal_square(...):
 *     ...
 *   ```
 *   </CodeBlock>
 *
 * The inner fenced block is highlighted by Astro's built-in Shiki.
 */

interface Props {
  lang?: string;
  file?: string;
}

const { lang = 'python', file } = Astro.props;
const label = file ? `${lang} · ${file}` : lang;
---

<div class="code" data-file={file}>
  <div class="chrome">
    <span class="lang">{label}</span>
    <button type="button" class="copy" data-copy-btn>Copy</button>
  </div>
  <slot />
</div>

<script>
  // Wire the Copy button on every code block. Safe to re-run on view transitions.
  function setupCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
      if (btn.dataset.copyWired) return;
      btn.dataset.copyWired = 'true';
      // Read the label once: capturing it per click stored "Copied" on a
      // quick second click, and the button then stayed stuck on "Copied".
      const label = btn.textContent;
      let resetTimer = 0;
      btn.addEventListener('click', async () => {
        const pre = btn.closest('.code')?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = 'Copied';
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => { btn.textContent = label; }, 1200);
        } catch {
          /* clipboard blocked — ignore */
        }
      });
    });
  }
  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);

  // ---------------------------------------------------------------------------
  // In-browser Python runner (AI tutor Milestone 1b).
  // The lesson <article> says whether the runner applies (data-runner) and where
  // the lesson's files live (data-lesson-media); see Lesson.astro. The Python runs
  // in a Web Worker with Pyodide (public/runner/python-worker.mjs), never on a server.
  // ---------------------------------------------------------------------------
  const RUN_TIMEOUT_MS = 120_000;   // includes the first-time Pyodide download
  const STORAGE_KEY = 'p2g-runner';

  type RunResult = {
    id: number; ok: boolean; stdout: string; stderr: string; error?: string;
    images: { name: string; mime: string; bytes: Uint8Array }[];
    timings: { loadMs?: number; packagesMs?: number; runMs?: number };
  };

  let worker: Worker | null = null;
  let pythonLoaded = false;
  let nextRunId = 1;
  const pending = new Map<number, (result: RunResult) => void>();

  function runnerEnabled(article: HTMLElement | null): boolean {
    const mode = article?.dataset.runner;
    if (mode === 'on') return true;
    if (mode !== 'flag') return false;
    // Production is off by default; ?runner=1 turns it on for this browser, ?runner=0 off.
    const param = new URLSearchParams(window.location.search).get('runner');
    try {
      if (param === '1') localStorage.setItem(STORAGE_KEY, '1');
      if (param === '0') localStorage.removeItem(STORAGE_KEY);
      return localStorage.getItem(STORAGE_KEY) === '1';
    } catch {
      return param === '1';   // storage blocked: honour the URL only
    }
  }

  // Only complete scripts get a Run button: fragments (no imports, no output) would fail.
  // Starter code with TODO gaps is left out: learners can't edit code on the page, so
  // running an unfinished starter would only show a confusing error (runner audit M4-8).
  function isRunnable(code: string): boolean {
    const hasImport = /^\s*(import|from)\s+\w+/m.test(code);
    const hasOutput = /(\.save\(|savefig\(|print\(|imwrite\(|mimsave\()/.test(code);
    const isStarter = /\bTODO\b/.test(code);
    return hasImport && hasOutput && !isStarter;
  }

  // Where Run appears (author's rule, 2026-09-25): only the Quick start script and the
  // EXECUTE exercise, the two places where learners run code as written. MODIFY and
  // CREATE code has to be completed first, and code inside dropdowns (hints, solution
  // snippets) is meant to be pasted into the learner's own script, so neither gets Run.
  function isRunPlace(block: HTMLElement): boolean {
    if (block.closest('details')) return false;
    const exercise = block.closest('article.ex');
    if (exercise) return exercise.querySelector('.num')?.getAttribute('data-stage') === 'execute';
    const heading = block.closest('section.lesson-section')?.querySelector('h2');
    return /^\s*quick start/i.test(heading?.textContent ?? '');
  }

  // textContent reads the code the same way whether or not it is on screen.
  const codeOf = (pre: HTMLElement) => pre.textContent ?? '';

  function getWorker(): Worker {
    if (!worker) {
      worker = new Worker('/runner/python-worker.mjs', { type: 'module' });
      worker.onmessage = ({ data }: MessageEvent<RunResult>) => {
        pending.get(data.id)?.(data);
        pending.delete(data.id);
      };
    }
    return worker;
  }

  // Runs go through a queue, one at a time: the worker has one Python interpreter and one
  // output capture, so two overlapping runs mixed their printed output (edge-case M1).
  let queue: Promise<unknown> = Promise.resolve();
  let running = false;

  function runPython(code: string, assetBase: string, fileName?: string, onStart?: () => void): Promise<RunResult> {
    const run = queue.then(() => {
      onStart?.();
      return startRun(code, assetBase, fileName);
    });
    queue = run.catch(() => undefined);
    return run;
  }

  // Ends the script that is running now (the Stop button, or the timeout). A running
  // Python loop can only be interrupted by killing the worker; the next run starts a
  // fresh one, which reloads Python from the browser cache in a few seconds.
  let stopCurrentRun: ((message: string) => void) | null = null;

  function startRun(code: string, assetBase: string, fileName?: string): Promise<RunResult> {
    const id = nextRunId++;
    running = true;
    return new Promise<RunResult>((resolve) => {
      const finish = (result: RunResult) => {
        window.clearTimeout(timer);
        pending.delete(id);
        stopCurrentRun = null;
        resolve(result);
      };
      stopCurrentRun = (message: string) => {
        worker?.terminate();
        worker = null;
        pythonLoaded = false;
        finish({ id, ok: false, stdout: '', stderr: '', images: [], timings: {}, error: message });
      };
      // The clock starts only when this run starts, not while it waits in the queue,
      // so a waiting run can't be reported as timed out (edge-case M2).
      const timer = window.setTimeout(
        () => stopCurrentRun?.(`Stopped after ${RUN_TIMEOUT_MS / 1000} seconds.`), RUN_TIMEOUT_MS);
      pending.set(id, finish);
      getWorker().postMessage({ id, code, assetBase, fileName });
    }).finally(() => { running = false; });
  }

  function showResult(output: HTMLElement, result: RunResult) {
    output.querySelectorAll('img').forEach((img) => URL.revokeObjectURL(img.src));
    output.replaceChildren();
    const status = document.createElement('p');
    status.className = 'code-output-status';
    const seconds = ((result.timings.runMs ?? 0) / 1000).toFixed(1);
    // A Stop click or the timeout is not an error in the learner's code.
    const stopped = !result.ok && (result.error ?? '').startsWith('Stopped');
    status.textContent = result.ok
      ? `Ran in ${seconds} s in your browser.`
      : stopped ? result.error! : 'The script stopped with an error.';
    output.append(status);

    // textContent everywhere: program output is shown as text, never as HTML.
    // On failure the error comes first, so long printed output can't push it out of
    // sight (edge-case M9); the printed output follows, shortened if very long.
    if (!result.ok && !stopped) {
      const error = document.createElement('pre');
      error.className = 'code-output-error';
      error.textContent = result.error ?? result.stderr ?? 'Unknown error.';
      output.append(error);
    }
    if (result.stdout) {
      const pre = document.createElement('pre');
      pre.textContent = result.stdout.length > 8000
        ? `${result.stdout.slice(0, 8000)}\n…(output shortened)`
        : result.stdout;
      output.append(pre);
    }
    for (const image of result.images) {
      const figure = document.createElement('figure');
      const img = document.createElement('img');
      // Copy into a plain ArrayBuffer-backed array: Blob doesn't accept views that
      // could sit on a SharedArrayBuffer (TypeScript 5.7+ checks this).
      img.src = URL.createObjectURL(new Blob([new Uint8Array(image.bytes)], { type: image.mime }));
      img.alt = `Output of the script: ${image.name}`;
      const caption = document.createElement('figcaption');
      caption.textContent = image.name;
      figure.append(img, caption);
      output.append(figure);
    }
  }

  function setupRunButtons() {
    const article = document.querySelector<HTMLElement>('article.lesson');
    if (!runnerEnabled(article)) return;
    const assetBase = article!.dataset.lessonMedia ?? '/';

    document.querySelectorAll<HTMLElement>('.code').forEach((block) => {
      if (block.dataset.runWired) return;
      block.dataset.runWired = 'true';
      const pre = block.querySelector('pre');
      const label = block.querySelector('.chrome .lang')?.textContent ?? '';
      if (!pre || !label.toLowerCase().startsWith('python') || !isRunPlace(block) || !isRunnable(codeOf(pre))) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'run';
      button.textContent = 'Run';
      button.title = 'Run this code in your browser';
      block.querySelector('.chrome .copy')?.before(button);

      const output = document.createElement('div');
      output.className = 'code-output';
      output.setAttribute('aria-live', 'polite');
      output.hidden = true;
      block.after(output);

      // One button, three states: Run -> Stop (while this block's script runs; disabled
      // while it waits for another block) -> Run again. No separate Stop button.
      let state: 'idle' | 'waiting' | 'running' = 'idle';

      button.addEventListener('click', async () => {
        if (state === 'running') {
          stopCurrentRun?.('Stopped.');
          return;
        }
        if (state === 'waiting') return;
        state = running ? 'waiting' : 'running';
        button.disabled = state === 'waiting';
        button.textContent = state === 'waiting' ? 'Waiting…' : 'Stop';
        button.title = 'Stop this script';
        output.hidden = false;
        output.replaceChildren();
        const status = document.createElement('p');
        status.className = 'code-output-status';
        const startMessage = () => (pythonLoaded
          ? 'Running…'
          : 'Loading Python into your browser from cdn.jsdelivr.net (first run only; this can take up to a minute)…');
        status.textContent = running ? 'Waiting for the other script on this page to finish…' : startMessage();
        output.append(status);
        const result = await runPython(codeOf(pre), assetBase, block.dataset.file, () => {
          state = 'running';
          button.disabled = false;
          button.textContent = 'Stop';
          status.textContent = startMessage();
        });
        pythonLoaded = pythonLoaded || result.ok || Boolean(result.timings.loadMs);
        showResult(output, result);
        state = 'idle';
        button.disabled = false;
        button.textContent = 'Run again';
        button.title = 'Run this code in your browser';
      });
    });
  }
  setupRunButtons();
  document.addEventListener('astro:page-load', setupRunButtons);
</script>
