---
/**
 * "How a workshop works" on /workshops (BLD-183, layout WL-1b): the three roles (final copy 1b), the free
 * sample card with Before / On the day / After (FR-6, replaces the four numbered steps) and the day timeline.
 * The evidence for the format sits in the FAQ (CR-3: no second copy here). Brand look: paper headers (CR-7a),
 * ink stripes on the day timeline. Copy: workshop-planning/review/
 * workshop-format-2026-11-12/final-copy.md (WC picks), split into short bullets without changing a fact.
 * Rendered only with PUBLIC_WORKSHOP_SERIES=true (it lives inside brand/Series.astro).
 */
import WorkshopDay from '@/components/workshops/WorkshopDay.astro';

const ROLES = [
  { fill: 'fill-c1', who: 'You', line: 'Type real code, get it wrong, fix it, at your own pace.' },
  { fill: 'fill-c2', who: 'The platform', line: 'Runs your code, checks every step, gives hints, then the solution.' },
  // Kağan, 13 Nov: the role, not his name ("my name would confuse people").
  { fill: 'fill-c3', who: 'Facilitator', line: "In the room when you're stuck." },
];

// FR-6 (R-6a8a-15): the free sample card, then Before / On the day / After. Copy: new-lessons-options-2026-11-14.html.
// The sample page (/try) is open (15 Nov): the card links to it. Page: src/pages/try.astro.
const SAMPLE_IMG = '/workshops/series/sample/';
const LATER = [
  { fill: 'fill-c1', title: 'Before', points: ['Your personal code', 'A warm-up if you are new'] },
  { fill: 'fill-c2', title: 'On the day', points: ['Three new lessons', 'Checks, hints, an AI tutor', 'Eight people, help in the room'] },
  { fill: 'fill-yellow', title: 'After', points: ['Your own piece', 'Lessons for good, AI tutor for 30 days'] },
];
---

<section class="ws fmt-band how-band" id="how-it-works" aria-labelledby="how-it-works-title">
  <div class="series-head">
    <h2 class="ws-display series-title" id="how-it-works-title">How a workshop works</h2>
    <p class="series-deck">No slides, no lecture. <span class="fmt-mark">You leave with a piece.</span></p>
  </div>

  <ul class="fmt-roles" aria-label="Who does what">
    {ROLES.map((r) => (
      <li class={`ws-card fmt-role ${r.fill}`}>
        <p class="ws-display fmt-role-head">{r.who}</p>
        <p class="fmt-role-line">{r.line}</p>
      </li>
    ))}
  </ul>

  <div class="try-band">
    <h3 class="ws-display fmt-sub">Try a step, then join</h3>
    <article class="ws-card try-card">
      <div class="try-pair">
        <figure>
          <img
            src={`${SAMPLE_IMG}dom-before.webp`}
            srcset={`${SAMPLE_IMG}dom-before-c360.webp 360w, ${SAMPLE_IMG}dom-before-c540.webp 540w, ${SAMPLE_IMG}dom-before.webp 720w`}
            sizes="(max-width: 640px) calc(50vw - 36px), (max-width: 1000px) 28vw, 310px"
            alt="The Berliner Dom and the Fernsehturm against a blue sky: the photo before printing."
            width="720"
            height="450"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Before</figcaption>
        </figure>
        <figure>
          <img
            src={`${SAMPLE_IMG}dom-poster.webp`}
            srcset={`${SAMPLE_IMG}dom-poster-c360.webp 360w, ${SAMPLE_IMG}dom-poster-c540.webp 540w, ${SAMPLE_IMG}dom-poster.webp 720w`}
            sizes="(max-width: 640px) calc(50vw - 36px), (max-width: 1000px) 28vw, 310px"
            alt="The same photo as a three-colour poster: dark stone in blue ink, mid tones in pink, the sky mostly cream paper with a pink band."
            width="720"
            height="450"
            loading="lazy"
            decoding="async"
          />
          <figcaption>After 15 minutes</figcaption>
        </figure>
      </div>
      <div class="try-body">
        <p class="try-kicker">Free sample · 15 min · in your browser</p>
        <h4 class="ws-display try-title">Print the Berliner Dom as a three-colour poster</h4>
        <p class="try-text">One workshop step, open to everyone. Make it first, predict, write, fix.</p>
        <a class="ws-btn" href="/try">Try it →</a>
      </div>
    </article>
    <div class="try-later">
      {LATER.map((c) => (
        <div class={c.fill}>
          <p class="try-kicker">{c.title}</p>
          <ul>
            {c.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <WorkshopDay />

  <a class="fmt-evidence" href="#faq-why">The evidence ↓</a>
</section>
