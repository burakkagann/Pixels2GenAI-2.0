---
/**
 * One workshop rendered as a collapsible <details> specimen card in the
 * landing § 2 catalog. Closed by default; pass `defaultOpen` to expand.
 *
 * Two variants by data shape, not by prop:
 *   status === 'past'  → completed badge · dimmed poster on the right ·
 *                        outcome row in the dl · "Read case study" link
 *   otherwise          → "In planning" badge · dashed poster placeholder ·
 *                        Register CTA · TBA values throughout the body
 *
 * String fields literally equal to 'TBA' render as plain "TBA" text.
 * `modules: []` renders as a single chip reading "TBA".
 * `capacity: 0` renders as "TBA" in the cohort line.
 *
 * With `bridge` (series flag on) a past workshop whose modules all carry a
 * `card` renders as the pilot row (DEC-102/103): the modules as mini cards
 * (MiniCards.astro, same as the series row), then the facts, no poster, and
 * a filled "✓ Completed" sticker. Flag off, the markup is unchanged.
 */
import type { Workshop } from '@/data/site/workshops';
import MiniCards, { type MiniCardItem } from '@/components/workshops/MiniCards.astro';

interface Props {
  workshop: Workshop;
  defaultOpen?: boolean;
  /** Series on (BLD-30): /workshops is the series page, so the past
   *  workshop links to its findings and to its own section there. */
  bridge?: boolean;
}

const { workshop: w, defaultOpen = false, bridge = false } = Astro.props;
const pastHref = bridge ? '/workshops#past' : '/workshops';

// Roman lowercase ordinal → zero-padded Arabic index ("i" → "01").
const romanToArabic: Record<string, number> = {
  i: 1, ii: 2, iii: 3, iv: 4, v: 5, vi: 6, vii: 7, viii: 8, ix: 9, x: 10,
};
const arabic = romanToArabic[w.ordinal.toLowerCase()] ?? 0;
const indexDisplay = String(arabic).padStart(2, '0');

const isPast = w.status === 'past';

// Pilot row on the series home page (DEC-102): only when every module has a card.
const pilotCards: MiniCardItem[] | null =
  bridge && isPast && w.modules.length > 0 && w.modules.every((m) => m.card)
    ? w.modules.map((m) => ({
        href: `/lessons/${m.idx}`,
        band: m.card!.band,
        head: m.idx,
        image: m.card!.image,
        title: m.card!.title,
        line: m.card!.line,
      }))
    : null;

const cohortLine = isPast
  ? `${w.participants ?? 'TBA'} participants · one day · pixel → diffusion`
  : w.capacity > 0
    ? `Up to ${w.capacity} participants · one day`
    : 'Capacity TBA · one day';

const identifier = isPast ? 'One-day intensive' : 'Next in the program';

const summaryMeta = `${w.city} · ${w.date}`;
---

<details class:list={['workshop-specimen', { 'pilot-specimen': pilotCards }]} open={defaultOpen}>
  <summary class="specimen-summary">
    <span class="summary-index">{indexDisplay}</span>
    <span class={`summary-status ${isPast ? 'completed' : 'planning'}${pilotCards ? ' done' : ''}`}>
      {isPast ? '✓ Completed' : '▌ In planning'}
    </span>
    <span class="summary-identifier">Workshop · <em>{isPast ? 'one-day intensive' : 'registration open'}</em></span>
    <span class="summary-meta">{summaryMeta}</span>
    <span class="summary-chevron" aria-hidden="true">
      <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="2,2 6,6 10,2"></polyline>
      </svg>
    </span>
  </summary>

  <article class:list={['specimen-body', { 'pilot-body': pilotCards }]}>
    <div class="specimen-text">
      <h3 class="specimen-title">{indexDisplay} · <em>{identifier}.</em></h3>

      {isPast ? (
        <p class="specimen-lede">
          Six modules, one sitting, in {w.city}. The first cohort produced the data reported in <a href="/research">/research</a>.
        </p>
      ) : (
        <p class="specimen-lede">
          The next one: a day with Academis, same shape as 01. Register interest now; date and venue follow.
        </p>
      )}

      {pilotCards && <MiniCards items={pilotCards} label="The six pilot modules" />}

      <dl class="specimen-dl">
        <dt>Date</dt>
        <dd>{w.date}{w.hours && <> · <em>{w.hours}</em></>}</dd>

        <dt>Where</dt>
        <dd>{w.city} · with <a href={w.supervisorHref} target="_blank" rel="noopener">Academis</a></dd>

        <dt>Cohort</dt>
        <dd>{cohortLine}</dd>

        {!pilotCards && (
          <>
            <dt>Modules</dt>
            <dd class="chips">
              {w.modules.length === 0 ? (
                <span class="chip">TBA</span>
              ) : (
                w.modules.map(m => (
                  <span class="chip"><b>{m.idx}</b>{m.title}</span>
                ))
              )}
            </dd>
          </>
        )}

        {w.outcome && (
          <>
            <dt>Outcome</dt>
            <dd>{w.outcome}</dd>
          </>
        )}
      </dl>

    </div>

    {pilotCards ? null : isPast ? (
      <div class="specimen-aside">
        <a class="specimen-poster" href={pastHref} aria-label="Open the workshop case study — poster lifts on hover">
          <img src={w.poster} alt={`Printed poster announcing Workshop ${indexDisplay} · ${w.city} · ${w.date}.`} loading="lazy" />
        </a>
        <div class="specimen-poster-cap">Poster · {w.city}</div>
      </div>
    ) : (
      <div class="specimen-aside specimen-aside--upcoming">
        <div class="specimen-poster-placeholder">
          <b>Poster · {indexDisplay}</b>
          <span>Designed once the date and venue land.</span>
        </div>
        <div class="specimen-upcoming-cta">
          <a class="btn btn-pri btn-workshop" href="/announce?topic=workshops" data-announce data-topic="workshops">Register interest →</a>
          <span class="note">No newsletter · single mail per workshop</span>
        </div>
      </div>
    )}
  </article>

  {isPast && (
    <div class="specimen-actions">
      {bridge ? (
        <>
          <a class="btn btn-sec" href="/research">Read the findings →</a>
          <a class="btn btn-sec" href={pastHref}>The pilot on the workshops page →</a>
        </>
      ) : (
        <a class="btn btn-sec" href="/workshops">See the full workshop →</a>
      )}
    </div>
  )}
</details>

