---
/**
 * The /workshops page hero in the workshop brand (05b): headline, one line,
 * the ticket buttons and a collage of the six card images. Rendered only when
 * PUBLIC_WORKSHOP_SERIES=true (the workshopArea integration swaps in an empty
 * stand-in from ../brand-off otherwise).
 */
import { SERIES } from '@/data/workshops/series';
import { TICKETS } from '@/data/workshops/tickets';

// Same switch as the tickets block: no shop link yet, so no buttons, just the notReady line.
const ticketsOpen = Boolean(TICKETS.pretix.w1);
const w1Shop = TICKETS.pretix.w1;
import '@/styles/workshop-brand.css';
import '@/styles/workshops-page.css';
---

<header class="ws series-hero">
  <div class="hero-copy">
    <p class="ws-chip fill-yellow hero-kicker">Workshop series · Berlin · 2026–27</p>
    <h1 class="ws-display hero-title">
      Write the code behind <span class="hero-mark">generative art.</span>
    </h1>
    <p class="hero-sub">Beyond prompting. Six Saturdays in Berlin, from a single pixel to a model that paints.</p>
    <div class="hero-actions">
      {ticketsOpen ? (
        <>
          <a class="ws-btn fill-studio" href={w1Shop!}>Get a W1 ticket →</a>
          <a class="ws-btn" href="#tickets">Series pass</a>
        </>
      ) : (
        <p class="tk-later">{TICKETS.notReady}</p>
      )}
      <a class="hero-link" href="#past">Where it started: the pilot ↓</a>
    </div>
  </div>
  <div class="hero-collage" aria-hidden="true">
    {SERIES.map((w) => (
      <img class="hero-tile" data-band-index={w.n} src={w.image.src} alt="" width="720" height="450" decoding="async" fetchpriority="low" />
    ))}
  </div>
</header>
