---
/**
 * The six-workshop series on the public /workshops page (BLD-09), in the
 * workshop brand (05b): the arc over the calendar with the dates on it
 * (DEC-81, DEC-82), the six cards and W7; then (BLD-183, WL-1b) how a workshop
 * works (with the workshop day), see how it all connects, the tickets block
 * and the FAQ (WL-2a: after the tickets, before the pilot).
 * Rendered only when
 * PUBLIC_WORKSHOP_SERIES=true. Data: src/data/workshops/series.ts.
 */
import { SERIES, SHOWCASE } from '@/data/workshops/series';
import SeriesCalendarArc from '@/components/workshops/SeriesCalendarArc.astro';
import SeriesCard from '@/components/workshops/SeriesCard.astro';
import HowItWorks from '@/components/workshops/HowItWorks.astro';
import WhyJoin from '@/components/workshops/WhyJoin.astro';
import WorkshopsFaq from '@/components/workshops/WorkshopsFaq.astro';
import { bandKey, shortDate } from '@/components/workshops/seriesFormat';
import { TICKETS } from '@/data/workshops/tickets';
import '@/styles/workshop-brand.css';
import '@/styles/workshops-page.css';

const datesPending = SERIES.some((w) => !w.dateIso);
const [first] = SERIES;
const w1Shop = TICKETS.pretix.w1;
const w1Luma = TICKETS.luma.w1;
const passShop = TICKETS.pretix.pass;
const P = TICKETS.price;
const late = new Date().toISOString().slice(0, 10) >= TICKETS.passLate.from;
const pass = late
  ? { label: 'Series pass · W2 to W6', standard: TICKETS.passLate.standard, reduced: TICKETS.passLate.reduced, until: TICKETS.passUntil }
  : { label: 'Series pass · all six Saturdays', standard: P.passStandard, reduced: P.passReduced, until: TICKETS.passAllSixUntil };
---

<section class="ws series" id="series" aria-labelledby="series-title">
  <div class="series-head">
    <h2 class="ws-display series-title" id="series-title">The arc</h2>
    <p class="series-deck">One idea per workshop. Each builds on the last, and each stands on its own.</p>
  </div>

  <SeriesCalendarArc />
  <p class="series-practical">Every workshop is a Saturday, {TICKETS.time}, with eight people at most.<br />{TICKETS.venueLine}</p>
  {/* Kağan, 13 Nov: no "Tickets open" placeholder under the arc (repeats the hero); the button shows once the shop link is set. */}
  {w1Shop && (
    <div class="series-buy">
      <a class="ws-btn btn-sale" href="#tickets">Get tickets ↓</a>
    </div>
  )}

  <div class="series-grid">
    {SERIES.map((w) => <SeriesCard workshop={w} />)}
  </div>

  <article class="ws-card series-showcase" id="showcase" aria-labelledby="showcase-title">
    <ul class="showcase-wall" aria-label="The wall, waiting for one piece from each workshop">
      {SERIES.map((w) => (
        <li data-band={bandKey(w.band)}>
          <span class="showcase-tag">W{w.n} {w.verb}</span>
          <span class="showcase-frame-text">{SHOWCASE.frameText}</span>
        </li>
      ))}
    </ul>
    <div class="showcase-body">
      <p class="ws-label showcase-kicker">W7 · {SHOWCASE.date} · {SHOWCASE.price}</p>
      <h3 class="ws-display showcase-title" id="showcase-title">{SHOWCASE.title}</h3>
      <p class="showcase-text">{SHOWCASE.idea}</p>
      <p class="showcase-note">{SHOWCASE.note}</p>
      <a class="ws-btn" href="/announce?topic=workshops" data-announce data-topic="workshops">{SHOWCASE.cta}</a>
    </div>
  </article>
</section>

<HowItWorks />
<WhyJoin />

<section class="ws fmt-band tix-band" aria-labelledby="tickets-title">
  <div class="ws-card series-cta" id="tickets">
    <div class="tk-wrap">
      <h2 class="ws-display cta-title" id="tickets-title">Tickets</h2>
      <div class="tk-grid">
        <div class="tk-col">
          <p class="ws-label">W1 See · {shortDate(first.dateIso!)}</p>
          <p class="tk-price">€{P.standard}</p>
          <p class="tk-sub">€{P.reduced} reduced for {TICKETS.reducedFor}. No proof needed.</p>
          <div class="sc-btns">
            {w1Shop ? <a class="ws-btn fill-studio" href={w1Shop}>Get a ticket →</a> : <p class="tk-later">{TICKETS.notReady}</p>}
            {w1Luma && <a class="ws-btn" href={w1Luma}>Also on Luma</a>}
          </div>
        </div>
        <div class="tk-col">
          <p class="ws-label">{pass.label}</p>
          <p class="tk-price">€{pass.standard}</p>
          <p class="tk-sub">€{pass.reduced} reduced. Limited, until {pass.until}. One code for the whole series.</p>
          <p class="tk-sub">{TICKETS.singlesLater}</p>
          <div class="sc-btns">
            {passShop ? <a class="ws-btn fill-studio" href={passShop}>Get the pass →</a> : <p class="tk-later">{TICKETS.notReady}</p>}
          </div>
        </div>
      </div>
      <ul class="tk-facts">
        <li>Max 8 people · 18+ · English</li>
        <li>Your own laptop is a must (Chrome or Firefox, and the charger)</li>
        <li>Bring one photo of your own. It stays on your laptop unless you choose to upload it.</li>
        <li>{TICKETS.venueLine} · hosted by {TICKETS.host} · run by Kağan</li>
        <li>Your personal code arrives by email seven days before your workshop</li>
      </ul>
      <p class="tk-small">No VAT is charged (§ 19 UStG). <a href={TICKETS.terms}>Ticket terms</a> · Not for W1? <a href="/announce?topic=workshops" data-announce data-topic="workshops">Hear when W2 opens</a></p>
    </div>
  </div>
</section>

<WorkshopsFaq />


<style>
  /* Phone taps: the two text links in the small print are about 17 px tall, so each gets an invisible
     hit area 44 px tall around it (the text and the line keep their size). */
  @media (max-width: 640px) {
    .tk-small a { position: relative; }
    .tk-small a::after { content: ''; position: absolute; inset: -14px -4px; }
  }
</style>
