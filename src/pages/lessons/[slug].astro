---
import { getCollection, render } from 'astro:content';
import Lesson from '@/layouts/Lesson.astro';
import Admonition from '@/components/lesson/mdx/Admonition.astro';
import Figure from '@/components/lesson/mdx/Figure.astro';
import CodeBlock from '@/components/lesson/mdx/CodeBlock.astro';
import Dropdown from '@/components/lesson/mdx/Dropdown.astro';
import Exercise from '@/components/lesson/mdx/Exercise.astro';
import Download from '@/components/lesson/mdx/Download.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  // lesson.id is the numeric leaf id (e.g. "2.1.1") via the glob loader's
  // generateId — independent of where the MDX file lives on disk.
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const slug = lesson.id;
const { Content, headings } = await render(lesson);

// The lesson's asset folder mirrors its MDX path (see CLAUDE.md "Lesson Layout"):
// src/content/lessons/Module_03_…/3.2_…/3.2.1_mask.mdx -> /lesson-media/Module_03_…/3.2_…/3.2.1_mask/
// The in-browser Python runner fetches input files (photos, text) from here.
const lessonPath = (lesson.filePath ?? '').replace(/\\/g, '/').split('src/content/lessons/')[1];
const mediaBase = lessonPath ? `/lesson-media/${lessonPath.replace(/\.mdx$/, '')}/` : undefined;
---

<Lesson slug={slug} frontmatter={lesson.data} headings={headings} mediaBase={mediaBase}>
  <Content components={{ Admonition, Figure, CodeBlock, Dropdown, Exercise, Download }} />
</Lesson>
