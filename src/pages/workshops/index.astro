---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/chrome/Footer.astro';
import AnnounceModal from '@/components/chrome/AnnounceModal.astro';
// Hero, series and pilot: the branded versions (components/workshops/brand/)
// when PUBLIC_WORKSHOP_SERIES=true, else today's markup verbatim
// (components/workshops/classic/); chosen at build time by the workshopArea
// integration (src/integrations/workshop-area.mjs).
import Hero from 'p2g:workshop-brand/Hero.astro';
import Series from 'p2g:workshop-brand/Series.astro';
import Pilot from 'p2g:workshop-brand/Pilot.astro';
import '@/styles/workshops.css';

// The six-workshop series (BLD-09). Opt-in: only "true" shows it; off, the
// page is exactly the pre-series version. Turned on once Kristian has seen
// the proposal (workshop-planning/follow-up.md BLD-09a).
const series = import.meta.env.PUBLIC_WORKSHOP_SERIES === 'true';

const pageTitle = series ? 'Workshops · The series and the pilot' : 'Workshops · A recurring program';
const pageDescription = series
  ? 'In-person Pixels2GenAI workshops in Berlin: a series of six, from pixels to generative AI, and the February 2026 pilot behind the research findings.'
  : 'The empirical engine of the Pixels2GenAI curriculum. A recurring one-day workshop run with Academis (Kristian Rother). The pilot cohort produced the data behind the /research findings; the next workshop is in planning.';
---

<Base title={pageTitle} description={pageDescription}>
  <main id="main-content" class="workshops-page">
    <!-- ========== HERO ========== -->
    <Hero /> <Series /><Pilot />
  </main>

  <AnnounceModal />
  <Footer />
</Base>
