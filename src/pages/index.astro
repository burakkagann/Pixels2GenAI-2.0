---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/chrome/Footer.astro';
import JourneyCube from '@/components/cube/JourneyCube.tsx';
import WorkshopSpecimen from '@/components/workshops/WorkshopSpecimen.astro';
import ExhibitionSpecimen from '@/components/exhibitions/ExhibitionSpecimen.astro';
import AnnounceModal from '@/components/chrome/AnnounceModal.astro';
import { MODULES } from '@/data/curriculum/modules';
import { SUBTOPICS, countLeaves } from '@/data/curriculum/subtopics';
import { RQS, CYCLES } from '@/data/site/research';
import { PAST_WORKSHOPS, UPCOMING_WORKSHOPS } from '@/data/site/workshops';
import { PAST_EXHIBITIONS } from '@/data/site/exhibitions';
import '@/styles/workshops.css';
import '@/styles/exhibitions.css';

// Entity graph for the homepage: a named author (Person) and the project
// (Organization) cross-linked by @id, then referenced as the author/provider of
// the Course and the publisher of the WebSite. The stable @id anchors let AI
// answer engines and knowledge graphs attribute the curriculum to the right
// person and project. sameAs ties the author to authoritative external profiles.
const SITE = 'https://pixels2genai.art';
const AUTHOR_ID = `${SITE}/#author`;
const ORG_ID = `${SITE}/#organization`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': AUTHOR_ID,
  name: 'Burak Kağan Yılmazer',
  url: 'https://burakkagan.dev',
  sameAs: [
    'https://orcid.org/0009-0000-9918-824X',
    'https://github.com/burakkagann',
    'https://www.linkedin.com/in/burakkagan/',
    'https://www.researchgate.net/profile/Burak-Kagan-Yilmazer-2',
  ],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Pixels2GenAI',
  url: SITE,
  logo: `${SITE}/icon-512.png`,
  founder: { '@id': AUTHOR_ID },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'Pixels2GenAI',
  url: SITE,
  inLanguage: 'en',
  publisher: { '@id': ORG_ID },
};

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `${SITE}/#course`,
  name: 'Pixels2GenAI',
  description:
    'A free, open-source curriculum that takes you from a single array element to building, training, and reasoning about modern generative models, across fifteen progressive modules.',
  provider: { '@id': ORG_ID },
  author: { '@id': AUTHOR_ID },
  image: `${SITE}/exhibitions/prints/orbit-sediment-trichrome.jpg`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  educationalLevel: 'beginner to advanced',
  url: SITE,
};

const siteJsonLd = [organizationJsonLd, personJsonLd, websiteJsonLd, courseJsonLd];

// Flat index of every leaf across all modules, for the curriculum search.
// Rendered server-side (all lesson links present in HTML) and filtered client-side.
const ALL_LEAVES = MODULES.flatMap(m =>
  (SUBTOPICS[m.idx] ?? []).flatMap(s =>
    s.leaves.map(l => ({
      mIdx: m.idx,
      mLabel: `${m.title} ${m.em}`,
      subTitle: s.title,
      id: l.id,
      title: l.title,
      slug: l.lessonSlug ?? null,
    }))
  )
);

// The same leaves grouped by module, in curriculum order, for the grouped
// search results. The script reorders groups and rows by relevance.
const RESULT_GROUPS = MODULES.map((m) => ({
  idx: m.idx,
  name: m.name ?? `${m.title} ${m.em}`.trim(),
  leaves: ALL_LEAVES.filter((l) => l.mIdx === m.idx),
})).filter((g) => g.leaves.length > 0);
---

<Base
  title="Pixels2GenAI — A Generative AI & Creative Coding Curriculum"
  onLanding={true}
  jsonLd={siteJsonLd}
>
  <main id="main-content">
  <!-- ========== COVER ========== -->
  <header class="cover">
    <div>
      {/* Author and affiliation, like a paper's title page: the name in the
          serif (Kağan, the name the author goes by, set bold), the thesis
          context below in the mono label style. */}
      <div class="eyebrow"><span><span class="eb-name"><span class="given">Burak</span> <span class="called">Kağan</span> <span class="family">Yılmazer</span></span><span class="eb-aff">MA Thesis · Design-Based Research · Cycle ii</span></span></div>
      <h1 class="cover-title">
        <span class="px">Pixels</span> <span class="am">to</span> <span class="it">generative AI,</span><br />
        one continuous journey.
      </h1>
      <p class="cover-lead">
        An open-source curriculum that takes you from a single array element to building, training, and reasoning about modern generative models, <em>across fifteen progressive modules</em>, each producing a visual artifact.
      </p>
      <div class="cover-meta">
        <div><b>Modules</b><span>15 + Capstone</span></div>
        <div><b>Method</b><span>DBR · 3 cycles</span></div>
        <div><b>Theory / Practice</b><span>40 / 60</span></div>
        <div><b>License</b><span>Open source · MIT + CC-BY</span></div>
      </div>
      <div class="cover-actions">
        {/* Curriculum first and in colour: visitors see what they would learn
            before being asked to start. */}
        <a class="btn btn-pri" href="#curriculum">See the curriculum</a>
        <a class="btn btn-sec" href="/lessons/1.1.1">Start learning</a>
      </div>
    </div>

    <!-- CUBE — React island on an exhibit plate, captioned like a
         manuscript figure. -->
    <div class="cube-plate">
      <div class="cube-caption">
        <span class="fig-num">Fig. 0</span>
        <span>The journey object · M 01 → M 12</span>
      </div>
      <JourneyCube client:idle />
    </div>
  </header>

  <!-- ========== SPECIMEN — three cycle stations ========== -->
  <section class="section" id="curriculum">
    <div class="section-head">
      <div class="section-num">§ 1 · <span>Curriculum</span></div>
      <div>
        <h2 class="section-title">From pixels, <em>to inference.</em></h2>
        <p class="section-desc">Three paths, each a few modules deep, building lesson by lesson. Linear by design, but experienced coders can jump to a later path. Open any module to see inside.</p>
      </div>
    </div>

    <div class="curriculum-tools">
      <div class="curriculum-search">
        <svg class="search-ic" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
        <input
          type="search"
          id="curriculum-search"
          placeholder="Search lessons by name or number"
          autocomplete="off"
          aria-label="Search the curriculum"
          aria-controls="curriculum-results"
        />
        <button type="button" class="search-clear" data-search-clear hidden aria-label="Clear search">Clear</button>
      </div>
      <span class="search-summary" data-search-summary hidden aria-live="polite"></span>
      <label class="search-include" data-include-wrap hidden>
        <input type="checkbox" id="curriculum-search-include" data-include />
        Include coming soon
      </label>
    </div>

    {/* Search results: grouped by module, ranked by the script (lesson id,
        then title, then module / subtopic), published lessons first, capped
        at a few rows with "Show all". Coming-soon lessons are collapsed into
        a count per module unless "Include coming soon" is on. */}
    <div class="curriculum-results" id="curriculum-results" data-results hidden>
      <div class="results-groups" data-groups>
        {RESULT_GROUPS.map((g) => (
          <section class="r-group" data-group hidden aria-labelledby={`rg-${g.idx}`}>
            <h3 class="r-group-head" id={`rg-${g.idx}`}><span class="r-group-code">M {g.idx}</span> {g.name}</h3>
            <div class="r-list" role="list" data-list>
              {g.leaves.map((leaf) => {
                // m06 and m6 / "module 6" all match: people rarely type the zero pad.
                const haystack = `${leaf.id} ${leaf.title} m${leaf.mIdx} m${Number(leaf.mIdx)} module ${Number(leaf.mIdx)} ${leaf.mLabel} ${leaf.subTitle}`.toLowerCase();
                const inner = (
                  <>
                    <span class="r-id">{leaf.id}</span>
                    <span class="r-title">{leaf.title}</span>
                    <span class="r-mod">{leaf.subTitle}</span>
                  </>
                );
                return leaf.slug
                  ? <div class="result" role="listitem" data-search={haystack} data-id={leaf.id} data-title={leaf.title} data-leaf-slug={leaf.slug} hidden>
                      {/* Link and toggle are siblings: a <button> inside an <a> is
                          invalid nesting and garbled the link's accessible name. */}
                      <a class="result-link" href={`/lessons/${leaf.slug}`}>{inner}</a>
                      <button type="button" class="leaf-done" data-leaf-toggle aria-label={`Toggle ${leaf.id} complete`} title="Mark complete">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    </div>
                  : <span class="result soon" role="listitem" data-search={haystack} data-id={leaf.id} data-title={leaf.title} hidden>
                      {inner}
                      <span class="r-soon">soon</span>
                    </span>;
              })}
            </div>
            <p class="r-soon-note" data-soon-note hidden></p>
          </section>
        ))}
      </div>
      <button type="button" class="r-more" data-more hidden></button>
      <div class="results-empty" data-results-empty hidden>
        <p data-empty-text></p>
        <button type="button" class="r-more" data-empty-action></button>
      </div>
    </div>

    <div class="stations" data-stations>
    {CYCLES.map(cy => {
      const cyc = cy.cycle === 'c1' ? 'I' : cy.cycle === 'c2' ? 'II' : 'III';
      const mods = MODULES.filter(m => m.cycle === cyc);
      const totals = mods.reduce(
        (acc, m) => {
          const c = countLeaves(m.idx);
          acc.leaves += c.leaves;
          return acc;
        },
        { leaves: 0 }
      );
      return (
        <div class="station" id={`station-${cy.cycle}`} style={`--cycle: var(--${cy.cycle});`}>
          <div class="station-head">
            <div class="station-left">
              <span class="station-label">Path {cyc}</span>
              <h3 class="station-title">{cy.name}<em>.</em></h3>
              <p class="station-pitch">{cy.pitch}</p>
            </div>
            <div class="station-right">
              <span><b>{mods.length}</b> modules</span>
              <span><b>{totals.leaves}</b> lessons</span>
              <span class="station-done" data-station-done hidden></span>
            </div>
          </div>

          <div class="station-cards">
            {mods.map(m => {
              const c = countLeaves(m.idx);
              return (
                <button
                  type="button"
                  class="mod-card"
                  data-m={m.idx}
                  aria-expanded="false"
                  aria-controls={`panel-${m.idx}`}
                >
                  <div class="card-top">
                    <b>M {m.idx}</b>
                    <span class="card-fw">{m.fw}</span>
                  </div>
                  {/* span, not h4: a <button> may only hold phrasing content. */}
                  <span class="card-title">{m.title}<br /><em>{m.em}</em></span>
                  <div class="card-meta"><span class="cm-subs">{c.subs} sub · </span>{c.leaves} lessons</div>
                </button>
              );
            })}
          </div>

          <div class="station-panels">
            {mods.map(m => {
              const subs = SUBTOPICS[m.idx] ?? [];
              const c = countLeaves(m.idx);
              return (
                <div class="station-panel" id={`panel-${m.idx}`} data-m={m.idx} hidden>
                  <div class="panel-head">
                    <span class="panel-num">M {m.idx}</span>
                    <h5>{m.title} <em>{m.em}</em></h5>
                    <span class="panel-fw">{m.fw} · {c.subs} sub-topics · {c.leaves} lessons</span>
                  </div>
                  <div class="panel-subs">
                    {subs.map(s => (
                      <div class="sub">
                        <h6><span class="snum">{s.id}</span>{s.title}</h6>
                        {s.leaves.map(l => (
                          l.lessonSlug
                            ? <div class="leaf" data-leaf-slug={l.lessonSlug}>
                                <a class="leaf-link" href={`/lessons/${l.lessonSlug}`}>
                                  <span class="lnum">{l.id}</span><span class="leaf-ttl">{l.title}</span>
                                </a>
                                <button type="button" class="leaf-done" data-leaf-toggle aria-label={`Toggle ${l.id} complete`} title="Mark complete">
                                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                              </div>
                            : <span class="leaf soon">
                                <span class="lnum">{l.id}</span><span class="leaf-ttl">{l.title}</span>
                              </span>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
    </div>
  </section>

  <script is:inline>
    // § 1 Curriculum — station accordion. One panel open per station; clicking
    // an already-active card closes it. Every card is its own Tab stop (plain
    // disclosure buttons, no roving tabindex); arrow keys also move focus
    // between cards within a station, Enter/Space toggle (native <button>),
    // Escape closes the open panel.
    //
    // Panel placement is layout-aware: on phones (≤540px, where the cards are a
    // single-column table of contents) the open panel is relocated to sit right
    // under its own card — a dropdown. On wider screens it returns to the
    // .station-panels block so it spans full-width beneath the card grid.
    const stationMq = matchMedia('(max-width: 540px)');
    document.querySelectorAll('.station').forEach((station) => {
      const cards = Array.from(station.querySelectorAll('.mod-card'));
      const panels = station.querySelectorAll('.station-panel');
      const panelHome = station.querySelector('.station-panels');

      // Hidden panels are display:none regardless of DOM position, so only the
      // open one needs correct placement for the current viewport.
      const place = (panel, card) => {
        if (stationMq.matches) card.after(panel);
        else panelHome.appendChild(panel);
      };

      const toggle = (card) => {
        const idx = card.getAttribute('data-m');
        const wasActive = card.classList.contains('active');
        cards.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-expanded', 'false');
        });
        panels.forEach((p) => {
          p.classList.remove('open');
          p.setAttribute('hidden', '');
        });
        if (!wasActive) {
          card.classList.add('active');
          card.setAttribute('aria-expanded', 'true');
          const panel = station.querySelector('.station-panel[data-m="' + idx + '"]');
          if (panel) {
            place(panel, card);
            panel.classList.add('open');
            panel.removeAttribute('hidden');
          }
        }
      };

      // Re-place the open panel if the layout crosses the phone breakpoint
      // (e.g. device rotation) so it never strands under the wrong card.
      stationMq.addEventListener('change', () => {
        const active = cards.find((c) => c.classList.contains('active'));
        if (!active) return;
        const panel = station.querySelector('.station-panel[data-m="' + active.getAttribute('data-m') + '"]');
        if (panel) place(panel, active);
      });

      cards.forEach((card, i) => {
        card.addEventListener('click', () => toggle(card));
        card.addEventListener('keydown', (e) => {
          let next = -1;
          switch (e.key) {
            case 'ArrowRight':
            case 'ArrowDown': next = (i + 1) % cards.length; break;
            case 'ArrowLeft':
            case 'ArrowUp':   next = (i - 1 + cards.length) % cards.length; break;
            case 'Home':      next = 0; break;
            case 'End':       next = cards.length - 1; break;
            case 'Escape':
              if (card.classList.contains('active')) { toggle(card); }
              return;
            default: return;
          }
          e.preventDefault();
          cards[next].focus();
        });
      });
    });
  </script>

  <script is:inline>
    // Lesson progress — completion state lives in localStorage['p2g-progress']
    // as a JSON array of lesson slugs. Reflected on every leaf/result with a
    // [data-leaf-slug], on per-station "done" counts, and on the global pill.
    (() => {
      const KEY = 'p2g-progress';
      const read = () => {
        try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); }
        catch { return new Set(); }
      };
      const write = (set) => {
        try { localStorage.setItem(KEY, JSON.stringify([...set])); } catch {}
      };

      const apply = () => {
        const done = read();
        document.querySelectorAll('[data-leaf-slug]').forEach((el) => {
          const isDone = done.has(el.getAttribute('data-leaf-slug'));
          el.classList.toggle('done', isDone);
          const btn = el.querySelector('[data-leaf-toggle]');
          if (btn) {
            btn.setAttribute('aria-pressed', String(isDone));
            btn.title = isDone ? 'Mark incomplete' : 'Mark complete';
          }
        });
        // Per-station counts (count unique slugs; a slug appears once per view).
        document.querySelectorAll('.station').forEach((st) => {
          const slugs = new Set(
            Array.from(st.querySelectorAll('.station-panel [data-leaf-slug]'))
              .map((el) => el.getAttribute('data-leaf-slug'))
          );
          const total = slugs.size;
          let d = 0;
          slugs.forEach((s) => { if (done.has(s)) d++; });
          const el = st.querySelector('[data-station-done]');
          if (el) {
            el.hidden = d === 0;
            el.textContent = d > 0 ? `${d} of ${total} done` : '';
          }
        });
      };

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-leaf-toggle]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const host = btn.closest('[data-leaf-slug]');
        if (!host) return;
        const slug = host.getAttribute('data-leaf-slug');
        const done = read();
        done.has(slug) ? done.delete(slug) : done.add(slug);
        write(done);
        apply();
      });

      // Refresh when returning to the page (e.g. after marking complete on a
      // lesson and navigating back) and on cross-tab storage changes.
      window.addEventListener('pageshow', apply);
      window.addEventListener('storage', (e) => { if (e.key === KEY) apply(); });
      apply();
    })();
  </script>

  <script is:inline>
    // Curriculum search — ranks the server-rendered result rows, groups them
    // by module and swaps them in for the accordion while a query is present.
    // Published lessons come first; coming-soon ones are counted per module
    // unless "Include coming soon" is on. Only the top CAP rows show until
    // "Show all" is pressed, so a one-letter query can't dump the catalog.
    (() => {
      const input = document.getElementById('curriculum-search');
      const results = document.querySelector('[data-results]');
      const stations = document.querySelector('[data-stations]');
      const summary = document.querySelector('[data-search-summary]');
      const empty = document.querySelector('[data-results-empty]');
      const clearBtn = document.querySelector('[data-search-clear]');
      const groupsBox = document.querySelector('[data-groups]');
      const moreBtn = document.querySelector('[data-more]');
      const includeBox = document.querySelector('[data-include]');
      const includeWrap = document.querySelector('[data-include-wrap]');
      const emptyText = document.querySelector('[data-empty-text]');
      const emptyAction = document.querySelector('[data-empty-action]');
      if (!input || !results || !stations || !groupsBox) return;

      const MIN = 2;
      const CAP = 8;
      const MODULE_TERM = /^m\d+$/;

      // Everything the ranking needs, read once from the markup.
      const rows = Array.from(results.querySelectorAll('.result')).map((el, order) => {
        const hay = el.getAttribute('data-search') || '';
        const title = el.getAttribute('data-title') || '';
        return {
          el,
          order,
          group: el.closest('[data-group]'),
          soon: el.classList.contains('soon'),
          id: (el.getAttribute('data-id') || '').toLowerCase(),
          title,
          titleLower: title.toLowerCase(),
          words: title.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean),
          hay,
          tokens: hay.split(/\s+/),
          idEl: el.querySelector('.r-id'),
          titleEl: el.querySelector('.r-title'),
        };
      });
      const groups = Array.from(groupsBox.querySelectorAll('[data-group]'));

      let showAll = false;
      let lastQuery = '';
      let currentMatches = 0;

      // Higher is better; 0 means the term does not match this row.
      const termScore = (row, t) => {
        if (MODULE_TERM.test(t)) return row.tokens.includes(t) ? 10 : 0;
        if (row.id === t) return 100;
        if (row.id.startsWith(t)) return 80;
        if (row.titleLower.startsWith(t)) return 60;
        if (row.words.some((w) => w.startsWith(t))) return 45;
        if (row.titleLower.includes(t)) return 25;
        if (row.hay.includes(t)) return 8;
        return 0;
      };

      const escapeHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      // Wrap each matched term in <mark>; the text is escaped piece by piece.
      const highlight = (text, re) => {
        if (!re) return escapeHtml(text);
        return text.split(re).map((part, i) => (i % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part))).join('');
      };

      const resetRows = () => {
        rows.forEach((r) => {
          r.el.hidden = true;
          r.titleEl.textContent = r.title;
          r.idEl.textContent = r.el.getAttribute('data-id');
        });
        groups.forEach((g) => { g.hidden = true; });
      };

      const showAccordion = (hint) => {
        resetRows();
        results.hidden = true;
        stations.hidden = false;
        includeWrap.hidden = true;
        clearBtn.hidden = !hint;
        summary.hidden = !hint;
        summary.textContent = hint || '';
        currentMatches = 0;
      };

      const run = (raw) => {
        const q = raw.trim().toLowerCase();
        if (q !== lastQuery) { showAll = false; lastQuery = q; }
        if (!q) return showAccordion('');
        if (q.length < MIN) return showAccordion('Keep typing…');

        // "module 6" / "m 6" -> "m6". A module term (m6, m06) must match a
        // whole token: as a substring "m1" also hit m10-m15, and the bare "6"
        // of "module 6" hit any lesson id containing a 6.
        const terms = q.replace(/\b(?:module|m)\s+(\d+)\b/g, 'm$1').split(/\s+/).filter(Boolean);
        const textTerms = terms.filter((t) => !MODULE_TERM.test(t));

        const scored = [];
        rows.forEach((row) => {
          let score = 0;
          for (const t of terms) {
            const s = termScore(row, t);
            if (!s) return; // every term has to match
            score += s;
          }
          // A multi-word query that appears verbatim in the title beats
          // rows that only match its words separately.
          if (terms.length > 1 && row.titleLower.includes(q)) score += 30;
          scored.push({ row, score });
        });
        const byRank = (a, b) => b.score - a.score || a.row.order - b.row.order;
        const avail = scored.filter((s) => !s.row.soon).sort(byRank);
        const soon = scored.filter((s) => s.row.soon).sort(byRank);
        const include = includeBox.checked;
        const ranked = include ? avail.concat(soon) : avail;
        const shown = showAll ? ranked : ranked.slice(0, CAP);
        currentMatches = scored.length;

        const re = textTerms.length
          ? new RegExp(`(${textTerms.slice().sort((a, b) => b.length - a.length).map(escapeRe).join('|')})`, 'gi')
          : null;

        resetRows();
        // Groups follow their best row; rows are appended in rank order, so
        // appendChild both moves and sorts them.
        const groupOrder = [];
        shown.forEach(({ row }) => {
          if (!groupOrder.includes(row.group)) groupOrder.push(row.group);
          row.el.hidden = false;
          row.titleEl.innerHTML = highlight(row.title, re);
          row.idEl.innerHTML = highlight(row.el.getAttribute('data-id'), re);
          row.group.querySelector('[data-list]').appendChild(row.el);
        });
        groupOrder.forEach((g) => {
          g.hidden = false;
          groupsBox.appendChild(g);
          const note = g.querySelector('[data-soon-note]');
          const hiddenSoon = include ? 0 : soon.filter((s) => s.row.group === g).length;
          note.hidden = hiddenSoon === 0;
          note.textContent = hiddenSoon ? `+${hiddenSoon} coming soon in this module` : '';
        });

        if (ranked.length > CAP) {
          moreBtn.hidden = false;
          moreBtn.textContent = showAll ? 'Show fewer' : `Show all ${ranked.length} results`;
        } else {
          moreBtn.hidden = true;
        }

        empty.hidden = ranked.length !== 0;
        if (!ranked.length) {
          if (soon.length && !include) {
            emptyText.textContent = `No published lesson matches “${raw.trim()}” yet. ${soon.length} coming-soon ${soon.length === 1 ? 'lesson matches' : 'lessons match'}.`;
            emptyAction.textContent = 'Show coming soon';
            emptyAction.dataset.action = 'include';
          } else {
            emptyText.textContent = `No lessons match “${raw.trim()}”. Try a lesson number such as 4.1, a module such as m9, or a topic such as noise.`;
            emptyAction.textContent = 'Clear search';
            emptyAction.dataset.action = 'clear';
          }
        }

        results.hidden = false;
        stations.hidden = true;
        clearBtn.hidden = false;
        includeWrap.hidden = false;
        summary.hidden = false;
        // Say how many are not yet published, so the count isn't a promise.
        summary.textContent = `${avail.length} ${avail.length === 1 ? 'lesson' : 'lessons'}` + (soon.length ? ` · ${soon.length} coming soon` : '');
      };

      const clear = () => { input.value = ''; run(''); input.focus(); };
      const visibleLinks = () => Array.from(results.querySelectorAll('.result:not([hidden]) .result-link'));

      moreBtn.addEventListener('click', () => { showAll = !showAll; run(input.value); });
      includeBox.addEventListener('change', () => run(input.value));
      emptyAction.addEventListener('click', () => {
        if (emptyAction.dataset.action === 'include') { includeBox.checked = true; run(input.value); }
        else clear();
      });

      // Arrow keys walk the visible result links; Up from the first returns
      // to the input. Enter in the input opens the top result. Esc clears.
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { input.value = ''; run(''); }
        else if (e.key === 'ArrowDown') {
          const first = visibleLinks()[0];
          if (first && !results.hidden) { e.preventDefault(); first.focus(); }
        } else if (e.key === 'Enter') {
          const first = visibleLinks()[0];
          if (first && !results.hidden) { e.preventDefault(); first.click(); }
        }
      });
      results.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.preventDefault(); clear(); return; }
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        const links = visibleLinks();
        const i = links.indexOf(document.activeElement);
        if (i === -1) return;
        e.preventDefault();
        if (e.key === 'ArrowDown') (links[i + 1] || links[i]).focus();
        else if (i === 0) input.focus();
        else links[i - 1].focus();
      });

      // Privacy-friendly DBR signal: record settled searches (not keystrokes)
      // and whether they returned anything, so curriculum gaps surface. Anonymous,
      // no identifier; no-op until the Umami loader is enabled. See /privacy.
      let searchTimer;
      const trackSearch = (raw) => {
        clearTimeout(searchTimer);
        const q = raw.trim();
        if (q.length < 2) return;
        searchTimer = setTimeout(() => {
          window.umami?.track('curriculum-search', {
            q: q.toLowerCase().slice(0, 60),
            results: currentMatches,
          });
        }, 700);
      };

      input.addEventListener('input', () => { run(input.value); trackSearch(input.value); });
      clearBtn.addEventListener('click', clear);
    })();
  </script>

