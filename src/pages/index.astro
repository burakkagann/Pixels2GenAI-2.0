---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/chrome/Footer.astro';
import JourneyCube from '@/components/cube/JourneyCube.tsx';
import WorkshopSpecimen from '@/components/workshops/WorkshopSpecimen.astro';
import ExhibitionSpecimen from '@/components/exhibitions/ExhibitionSpecimen.astro';
import AnnounceModal from '@/components/chrome/AnnounceModal.astro';
import { MODULES } from '@/data/curriculum/modules';
import { SUBTOPICS, countLeaves } from '@/data/curriculum/subtopics';
import { RQS, CYCLES } from '@/data/site/research';
import { PAST_WORKSHOPS, UPCOMING_WORKSHOPS } from '@/data/site/workshops';
import { PAST_EXHIBITIONS } from '@/data/site/exhibitions';
import '@/styles/workshops.css';
import '@/styles/exhibitions.css';

// Entity graph for the homepage: a named author (Person) and the project
// (Organization) cross-linked by @id, then referenced as the author/provider of
// the Course and the publisher of the WebSite. The stable @id anchors let AI
// answer engines and knowledge graphs attribute the curriculum to the right
// person and project. sameAs ties the author to authoritative external profiles.
const SITE = 'https://pixels2genai.art';
const AUTHOR_ID = `${SITE}/#author`;
const ORG_ID = `${SITE}/#organization`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': AUTHOR_ID,
  name: 'Burak Kağan Yılmazer',
  url: 'https://burakkagan.dev',
  sameAs: [
    'https://orcid.org/0009-0000-9918-824X',
    'https://github.com/burakkagann',
    'https://www.linkedin.com/in/burakkagan/',
    'https://www.researchgate.net/profile/Burak-Kagan-Yilmazer-2',
  ],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Pixels2GenAI',
  url: SITE,
  logo: `${SITE}/icon-512.png`,
  founder: { '@id': AUTHOR_ID },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'Pixels2GenAI',
  url: SITE,
  inLanguage: 'en',
  publisher: { '@id': ORG_ID },
};

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `${SITE}/#course`,
  name: 'Pixels2GenAI',
  description:
    'A free, open-source curriculum that takes you from a single array element to building, training, and reasoning about modern generative models, across fifteen progressive modules.',
  provider: { '@id': ORG_ID },
  author: { '@id': AUTHOR_ID },
  image: `${SITE}/exhibitions/prints/orbit-sediment-trichrome.jpg`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  educationalLevel: 'beginner to advanced',
  url: SITE,
};

const siteJsonLd = [organizationJsonLd, personJsonLd, websiteJsonLd, courseJsonLd];

// Flat index of every leaf across all modules, for the curriculum search.
// Rendered server-side (all lesson links present in HTML) and filtered client-side.
const ALL_LEAVES = MODULES.flatMap(m =>
  (SUBTOPICS[m.idx] ?? []).flatMap(s =>
    s.leaves.map(l => ({
      mIdx: m.idx,
      mLabel: `${m.title} ${m.em}`,
      subTitle: s.title,
      id: l.id,
      title: l.title,
      slug: l.lessonSlug ?? null,
    }))
  )
);
---

<Base
  title="Pixels2GenAI — A Generative AI & Creative Coding Curriculum"
  onLanding={true}
  jsonLd={siteJsonLd}
>
  <!-- ========== COVER ========== -->
  <header class="cover">
    <div>
      <div class="eyebrow"><span><b>MA Thesis</b> · Design-Based Research · Cycle ii</span></div>
      <h1 class="cover-title">
        <span class="px">Pixels</span> <span class="am">to</span> <span class="it">generative AI,</span><br />
        one continuous journey.
      </h1>
      <p class="cover-lead">
        An open-source curriculum that takes you from a single array element to building, training, and reasoning about modern generative models, <em>across fifteen progressive modules</em>, each producing a visual artifact.
      </p>
      <div class="cover-meta">
        <div><b>Modules</b><span>15 + Capstone</span></div>
        <div><b>Method</b><span>DBR · 3 cycles</span></div>
        <div><b>Theory / Practice</b><span>40 / 60</span></div>
        <div><b>License</b><span>Open source · MIT + CC-BY</span></div>
      </div>
      <div class="cover-actions">
        <a class="btn btn-pri" href="/lessons/1.1.1">Start learning</a>
        <a class="btn btn-sec" href="#curriculum">See the curriculum</a>
      </div>
    </div>

    <!-- CUBE — React island on an exhibit plate, captioned like a
         manuscript figure. -->
    <div class="cube-plate">
      <div class="cube-caption">
        <span class="fig-num">Fig. 0</span>
        <span>The journey object · M 01 → M 12</span>
      </div>
      <JourneyCube client:idle />
    </div>
  </header>

  <!-- ========== SPECIMEN — three cycle stations ========== -->
  <section class="section" id="curriculum">
    <div class="section-head">
      <div class="section-num">§ 1 · <span>Curriculum</span></div>
      <div>
        <h2 class="section-title">From pixels, <em>to inference.</em></h2>
        <p class="section-desc">Three paths, each a few modules deep, building lesson by lesson. Linear by design, but experienced coders can jump to a later path. Open any module to see inside.</p>
      </div>
    </div>

    <div class="curriculum-tools">
      <div class="curriculum-search">
        <svg class="search-ic" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
        <input
          type="search"
          id="curriculum-search"
          placeholder="Search lessons by name or number"
          autocomplete="off"
          aria-label="Search the curriculum"
          aria-controls="curriculum-results"
        />
        <button type="button" class="search-clear" data-search-clear hidden aria-label="Clear search">Clear</button>
      </div>
      <span class="search-summary" data-search-summary hidden aria-live="polite"></span>
    </div>

    <div class="curriculum-results" id="curriculum-results" data-results hidden role="list">
      {ALL_LEAVES.map(leaf => {
        const haystack = `${leaf.id} ${leaf.title} m${leaf.mIdx} ${leaf.mLabel} ${leaf.subTitle}`.toLowerCase();
        const inner = (
          <>
            <span class="r-id">{leaf.id}</span>
            <span class="r-title">{leaf.title}</span>
            <span class="r-mod">M {leaf.mIdx} · {leaf.subTitle}</span>
          </>
        );
        return leaf.slug
          ? <a class="result" role="listitem" data-search={haystack} data-leaf-slug={leaf.slug} href={`/lessons/${leaf.slug}`} hidden>
              {inner}
              <button type="button" class="leaf-done" data-leaf-toggle aria-label={`Toggle ${leaf.id} complete`} title="Mark complete">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </a>
          : <span class="result soon" role="listitem" data-search={haystack} hidden>
              {inner}
              <span class="r-soon">soon</span>
            </span>;
      })}
      <p class="results-empty" data-results-empty hidden>No lessons match that search.</p>
    </div>

    <div class="stations" data-stations>
    {CYCLES.map(cy => {
      const cyc = cy.cycle === 'c1' ? 'I' : cy.cycle === 'c2' ? 'II' : 'III';
      const mods = MODULES.filter(m => m.cycle === cyc);
      const totals = mods.reduce(
        (acc, m) => {
          const c = countLeaves(m.idx);
          acc.leaves += c.leaves;
          return acc;
        },
        { leaves: 0 }
      );
      return (
        <div class="station" id={`station-${cy.cycle}`} style={`--cycle: var(--${cy.cycle});`}>
          <div class="station-head">
            <div class="station-left">
              <span class="station-label">Path {cyc}</span>
              <h3 class="station-title">{cy.name}<em>.</em></h3>
              <p class="station-pitch">{cy.pitch}</p>
            </div>
            <div class="station-right">
              <span><b>{mods.length}</b> modules</span>
              <span><b>{totals.leaves}</b> lessons</span>
              <span class="station-done" data-station-done hidden></span>
            </div>
          </div>

          <div class="station-cards">
            {mods.map(m => {
              const c = countLeaves(m.idx);
              return (
                <button
                  type="button"
                  class="mod-card"
                  data-m={m.idx}
                  aria-expanded="false"
                  aria-controls={`panel-${m.idx}`}
                >
                  <div class="card-top">
                    <b>M {m.idx}</b>
                    <span class="card-fw">{m.fw}</span>
                  </div>
                  <h4>{m.title}<br /><em>{m.em}</em></h4>
                  <div class="card-meta">{c.subs} sub · {c.leaves} lessons</div>
                </button>
              );
            })}
          </div>

          <div class="station-panels">
            {mods.map(m => {
              const subs = SUBTOPICS[m.idx] ?? [];
              const c = countLeaves(m.idx);
              return (
                <div class="station-panel" id={`panel-${m.idx}`} data-m={m.idx} hidden>
                  <div class="panel-head">
                    <span class="panel-num">M {m.idx}</span>
                    <h5>{m.title} <em>{m.em}</em></h5>
                    <span class="panel-fw">{m.fw} · {c.subs} sub-topics · {c.leaves} lessons</span>
                  </div>
                  <div class="panel-subs">
                    {subs.map(s => (
                      <div class="sub">
                        <h6><span class="snum">{s.id}</span>{s.title}</h6>
                        {s.leaves.map(l => (
                          l.lessonSlug
                            ? <a class="leaf" href={`/lessons/${l.lessonSlug}`} data-leaf-slug={l.lessonSlug}>
                                <span class="lnum">{l.id}</span><span class="leaf-ttl">{l.title}</span>
                                <button type="button" class="leaf-done" data-leaf-toggle aria-label={`Toggle ${l.id} complete`} title="Mark complete">
                                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                              </a>
                            : <span class="leaf soon">
                                <span class="lnum">{l.id}</span><span class="leaf-ttl">{l.title}</span>
                              </span>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
    </div>
  </section>

  <script is:inline>
    // § 1 Curriculum — station accordion. One panel open per station; clicking
    // an already-active card closes it. Module cards are roving-tabindex: arrow
    // keys move focus within a station, Enter/Space toggle (native <button>),
    // Escape closes the open panel.
    //
    // Panel placement is layout-aware: on phones (≤540px, where the cards are a
    // single-column table of contents) the open panel is relocated to sit right
    // under its own card — a dropdown. On wider screens it returns to the
    // .station-panels block so it spans full-width beneath the card grid.
    const stationMq = matchMedia('(max-width: 540px)');
    document.querySelectorAll('.station').forEach((station) => {
      const cards = Array.from(station.querySelectorAll('.mod-card'));
      const panels = station.querySelectorAll('.station-panel');
      const panelHome = station.querySelector('.station-panels');

      // Hidden panels are display:none regardless of DOM position, so only the
      // open one needs correct placement for the current viewport.
      const place = (panel, card) => {
        if (stationMq.matches) card.after(panel);
        else panelHome.appendChild(panel);
      };

      const toggle = (card) => {
        const idx = card.getAttribute('data-m');
        const wasActive = card.classList.contains('active');
        cards.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-expanded', 'false');
        });
        panels.forEach((p) => {
          p.classList.remove('open');
          p.setAttribute('hidden', '');
        });
        if (!wasActive) {
          card.classList.add('active');
          card.setAttribute('aria-expanded', 'true');
          const panel = station.querySelector('.station-panel[data-m="' + idx + '"]');
          if (panel) {
            place(panel, card);
            panel.classList.add('open');
            panel.removeAttribute('hidden');
          }
        }
      };

      // Re-place the open panel if the layout crosses the phone breakpoint
      // (e.g. device rotation) so it never strands under the wrong card.
      stationMq.addEventListener('change', () => {
        const active = cards.find((c) => c.classList.contains('active'));
        if (!active) return;
        const panel = station.querySelector('.station-panel[data-m="' + active.getAttribute('data-m') + '"]');
        if (panel) place(panel, active);
      });

      cards.forEach((card, i) => {
        card.addEventListener('click', () => toggle(card));
        card.addEventListener('keydown', (e) => {
          let next = -1;
          switch (e.key) {
            case 'ArrowRight':
            case 'ArrowDown': next = (i + 1) % cards.length; break;
            case 'ArrowLeft':
            case 'ArrowUp':   next = (i - 1 + cards.length) % cards.length; break;
            case 'Home':      next = 0; break;
            case 'End':       next = cards.length - 1; break;
            case 'Escape':
              if (card.classList.contains('active')) { toggle(card); }
              return;
            default: return;
          }
          e.preventDefault();
          cards[next].focus();
        });
      });
    });
  </script>

  <script is:inline>
    // Lesson progress — completion state lives in localStorage['p2g-progress']
    // as a JSON array of lesson slugs. Reflected on every leaf/result with a
    // [data-leaf-slug], on per-station "done" counts, and on the global pill.
    (() => {
      const KEY = 'p2g-progress';
      const read = () => {
        try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); }
        catch { return new Set(); }
      };
      const write = (set) => {
        try { localStorage.setItem(KEY, JSON.stringify([...set])); } catch {}
      };

      const apply = () => {
        const done = read();
        document.querySelectorAll('[data-leaf-slug]').forEach((el) => {
          const isDone = done.has(el.getAttribute('data-leaf-slug'));
          el.classList.toggle('done', isDone);
          const btn = el.querySelector('[data-leaf-toggle]');
          if (btn) {
            btn.setAttribute('aria-pressed', String(isDone));
            btn.title = isDone ? 'Mark incomplete' : 'Mark complete';
          }
        });
        // Per-station counts (count unique slugs; a slug appears once per view).
        document.querySelectorAll('.station').forEach((st) => {
          const slugs = new Set(
            Array.from(st.querySelectorAll('.station-panel [data-leaf-slug]'))
              .map((el) => el.getAttribute('data-leaf-slug'))
          );
          const total = slugs.size;
          let d = 0;
          slugs.forEach((s) => { if (done.has(s)) d++; });
          const el = st.querySelector('[data-station-done]');
          if (el) {
            el.hidden = d === 0;
            el.textContent = d > 0 ? `${d} of ${total} done` : '';
          }
        });
      };

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-leaf-toggle]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const host = btn.closest('[data-leaf-slug]');
        if (!host) return;
        const slug = host.getAttribute('data-leaf-slug');
        const done = read();
        done.has(slug) ? done.delete(slug) : done.add(slug);
        write(done);
        apply();
      });

      // Refresh when returning to the page (e.g. after marking complete on a
      // lesson and navigating back) and on cross-tab storage changes.
      window.addEventListener('pageshow', apply);
      window.addEventListener('storage', (e) => { if (e.key === KEY) apply(); });
      apply();
    })();
  </script>

  <script is:inline>
    // Curriculum search — filters the server-rendered flat result list and
    // swaps it in for the accordion while a query is present.
    (() => {
      const input = document.getElementById('curriculum-search');
      const results = document.querySelector('[data-results]');
      const stations = document.querySelector('[data-stations]');
      const summary = document.querySelector('[data-search-summary]');
      const empty = document.querySelector('[data-results-empty]');
      const clearBtn = document.querySelector('[data-search-clear]');
      if (!input || !results || !stations) return;

      const rows = Array.from(results.querySelectorAll('.result'));

      let currentMatches = 0;

      const run = (raw) => {
        const q = raw.trim().toLowerCase();
        if (!q) {
          results.hidden = true;
          stations.hidden = false;
          summary.hidden = true;
          clearBtn.hidden = true;
          currentMatches = 0;
          return;
        }
        const terms = q.split(/\s+/);
        let matches = 0;
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          const hit = terms.every((t) => hay.includes(t));
          row.hidden = !hit;
          if (hit) matches++;
        });
        currentMatches = matches;
        results.hidden = false;
        stations.hidden = true;
        clearBtn.hidden = false;
        empty.hidden = matches !== 0;
        summary.hidden = false;
        summary.textContent = `${matches} ${matches === 1 ? 'lesson' : 'lessons'}`;
      };

      // Privacy-friendly DBR signal: record settled searches (not keystrokes)
      // and whether they returned anything, so curriculum gaps surface. Anonymous,
      // no identifier; no-op until the Umami loader is enabled. See /privacy.
      let searchTimer;
      const trackSearch = (raw) => {
        clearTimeout(searchTimer);
        const q = raw.trim();
        if (q.length < 2) return;
        searchTimer = setTimeout(() => {
          window.umami?.track('curriculum-search', {
            q: q.toLowerCase().slice(0, 60),
            results: currentMatches,
          });
        }, 700);
      };

      input.addEventListener('input', () => { run(input.value); trackSearch(input.value); });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { input.value = ''; run(''); }
      });
      clearBtn.addEventListener('click', () => { input.value = ''; run(''); input.focus(); });
    })();
  </script>

  <!-- ========== WORKSHOPS — recurring program archive ========== -->
  <section class="section" id="workshops">
    <div class="section-head">
      <div class="section-num">§ 2 · <span>Workshops</span></div>
      <div>
        <h2 class="section-title">The curriculum, <em>in a single day.</em></h2>
        <p class="section-desc">A recurring one-day workshop: the whole curriculum in a single sitting. First cohort below; the next is in planning.</p>
      </div>
    </div>

    <div class="workshops-archive">
      <div class="archive-head">
        <span class="archive-org">Pixels2GenAI · Workshop archive</span>
        <span class="archive-count">▌ {PAST_WORKSHOPS.length} completed · {UPCOMING_WORKSHOPS.length} in planning</span>
      </div>

      {PAST_WORKSHOPS.map(w => <WorkshopSpecimen workshop={w} />)}
      {UPCOMING_WORKSHOPS.map(w => <WorkshopSpecimen workshop={w} defaultOpen={true} />)}
    </div>
  </section>

  <!-- ========== EXHIBITION — one-off group show archive ========== -->
  <section class="section" id="exhibition">
    <div class="section-head">
      <div class="section-num">§ 3 · <span>Exhibition</span></div>
      <div>
        <h2 class="section-title">The studio, <em>transformed into a gallery.</em></h2>
        <p class="section-desc">A group show with <a href="https://www.academis.eu" target="_blank" rel="noopener">Kristian Rother</a> and Academis: six artists, printed and code-driven pieces, several built from curriculum modules. Archive below; next show unscheduled.</p>
      </div>
    </div>

    <div class="exhibitions-archive">
      <div class="exhibition-archive-head">
        <span class="archive-org">Pixels2GenAI · Exhibition archive</span>
        <span class="archive-count">▌ {String(PAST_EXHIBITIONS.length).padStart(2, '0')} completed</span>
      </div>

      {PAST_EXHIBITIONS.map(ex => <ExhibitionSpecimen exhibition={ex} defaultOpen={true} />)}
    </div>
  </section>

  <script is:inline>
    // Phone widths: the exhibition specimen starts closed — its open body
    // (poster, case text, plate strip) costs several viewports of scroll.
    // Progressive enhancement: without JS it simply stays open. The
    // "In planning" workshop specimen stays open — it carries the
    // Register CTA.
    if (matchMedia('(max-width: 640px)').matches) {
      document.querySelectorAll('.exhibition-specimen[open]').forEach((d) => {
        d.removeAttribute('open');
      });
    }
  </script>

  <!-- ========== RESEARCH ========== -->
  <section class="section" id="research">
    <div class="section-head">
      <div class="section-num">§ 4 · <span>Research</span></div>
      <div>
        <h2 class="section-title">Five questions, <em>three cycles.</em></h2>
        <p class="section-desc">The curriculum is the artifact of a design-based research thesis. Three cycles, the same five questions; this is the third.</p>
      </div>
    </div>

    <div class="rqs">
      {RQS.map(rq => (
        <div class="rq">
          <div class="tag">{rq.tag}</div>
          <h4>{rq.title}</h4>
          <p>{rq.gloss}</p>
        </div>
      ))}
    </div>

    <div class="research-cta">
      <a class="btn btn-sec" href="/research">Read the full study →</a>
      <span class="research-cta-meta">DBR pilot · n = 9 · Cohen's d = 1.615 · ρ = −0.857</span>
    </div>
  </section>

  <!-- ========== ANNOUNCEMENTS — shared capture strip ==========
       The site's one capture moment, directly above the footer.
       Serves both archives; the CTA opens the AnnounceModal popup
       (no-JS fallback: the /announce page). -->
  <div class="announce-band" id="announcements">
    <aside class="announce-strip" aria-label="Event announcements">
      <span class="strip-eyebrow"><span class="dot" aria-hidden="true"></span>§ Announcements</span>
      <p>One mail when the next workshop or exhibition is confirmed. No newsletter, no sharing, opt out anytime.</p>
      <a class="btn btn-pri" href="/announce" data-announce data-topic="both">Leave your email →</a>
    </aside>
  </div>

  <AnnounceModal />
  <Footer />
</Base>
