---
// /announce/thanks: where the announcements form lands when it is sent
// without JavaScript (the form's action). With JS the pop-up shows the
// same message in place and never comes here. noindex (and left out of
// the sitemap in astro.config.mjs). Also the target of the retired
// /workshops/thanks URL (netlify.toml).
import Base from '@/layouts/Base.astro';
import Footer from '@/components/chrome/Footer.astro';
import { ANNOUNCE_DONE } from '@/data/site/announce';
import '@/styles/announce.css';
---

<Base
  title="Thanks · Announcements"
  noindex
  description="You're on the Pixels2GenAI announcements list."
>
  <main id="main-content" class="thanks-page">
    <div class="ok-card">
      <span class="ok-chip">{ANNOUNCE_DONE.chip}</span>
      <h1 class="sp-h">{ANNOUNCE_DONE.title}</h1>
      <p class="sp-lede">{ANNOUNCE_DONE.text}</p>
      <a class="btn btn-pri btn-signup" href="/">Back to the site →</a>
    </div>
  </main>

  <Footer />
</Base>
