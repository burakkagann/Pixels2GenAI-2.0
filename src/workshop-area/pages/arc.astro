---
// Arc page for one workshop (/workshops/w1-see). Routed only when
// PUBLIC_WORKSHOP_AREA=true (astro.config.mjs). BLD-01 stub: it proves the flag,
// the noindex and the sitemap exclusion; the real arc page replaces it in BLD-03.
import Base from '@/layouts/Base.astro';
import Footer from '@/components/chrome/Footer.astro';
import { SERIES, type SeriesWorkshop } from '@/data/workshops/series';

export function getStaticPaths() {
  return SERIES.map((workshop) => ({ params: { workshop: workshop.slug }, props: { workshop } }));
}

const { workshop } = Astro.props as { workshop: SeriesWorkshop };
---

<!-- No jsonLd: the participant area stays out of structured data. -->
<Base title={`W${workshop.n} ${workshop.verb}`} noindex description={workshop.idea}>
  <main id="main-content" class="ws-stub">
    <h1>W{workshop.n} · {workshop.verb}: {workshop.title}</h1>
    <p>{workshop.idea}</p>
    <ol>
      {workshop.cores.map((core) => <li>{core.id} {core.title}</li>)}
    </ol>
  </main>
  <Footer />
</Base>

<style>
  .ws-stub {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px var(--pad-x) 96px;
  }
</style>
