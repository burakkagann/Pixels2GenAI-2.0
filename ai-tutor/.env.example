# AI tutor settings. Copy this file to ai-tutor/.env and fill in the values.
# ai-tutor/.env is ignored by git: never commit it, never paste its values into chat.

# Anthropic (Claude Console -> your tutor workspace -> API keys)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-4-5

# Google Cloud (not secret; needed from the Cloud Run part of Milestone 2)
GCP_PROJECT_ID=
GCP_REGION=europe-west3

# Langfuse Cloud, EU region (Project settings -> API keys); optional until tracing is added
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
